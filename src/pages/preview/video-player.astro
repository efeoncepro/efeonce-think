---
import BaseLayout from '@layouts/BaseLayout.astro'
import AxisVideoPlayer from '@/components/AxisVideoPlayer.astro'
import {axis} from '@lib/report-tokens'
import type { VideoPlayerModel } from '@efeoncepro/axis-ui-primitives/video-player'
const model:VideoPlayerModel={id:'think-video-preview',title:'De la pregunta a la respuesta',src:'/preview-media/sparks-review.mp4',poster:'/preview-media/sparks-poster.png',skin:'cinema' as const,presentation:'embedded' as const,preload:'metadata' as const,duration:49.583008,assetVersion:'sparks-cut-02',versionLabel:'Corte 02',thumbnails:'/preview-media/sparks-thumbnails.vtt',chapters:[{id:'pregunta',time:0,label:'La pregunta'},{id:'equipo',time:10.44,label:'El equipo'},{id:'medida',time:15.89,label:'Medir y ordenar'},{id:'respuesta',time:33.58,label:'La respuesta'}],transcript:[{"id": "speech-1", "time": 0.25, "end": 3.5, "label": "Tus clientes ya no solo buscan: le preguntan a la IA."}, {"id": "speech-2", "time": 6.88, "end": 9.75, "label": "Y si la IA no te conoce, no te nombra."}, {"id": "speech-3", "time": 10.44, "end": 15.84, "label": "Con Efeonce AEO, nuestro equipo y los Sparks, nuestros agentes, se ponen a trabajar contigo."}, {"id": "speech-4", "time": 15.89, "end": 18.4, "label": "Primero, medimos cómo te describen las IA:"}, {"id": "speech-5", "time": 18.45, "end": 21.0, "label": "qué fuentes leen y quién aparece en tu lugar."}, {"id": "speech-6", "time": 21.12, "end": 22.75, "label": "Después, ordenamos lo que falta:"}, {"id": "speech-7", "time": 22.8, "end": 26.51, "label": "contenido claro, una marca bien definida y fuentes que te respalden."}, {"id": "speech-8", "time": 26.56, "end": 29.68, "label": "Lo ves todo en un reporte, y tú decides cada paso."}, {"id": "speech-9", "time": 33.58, "end": 37.31, "label": "Ahora, cuando la IA responde, tiene con qué nombrarte."}, {"id": "speech-10", "time": 38.61, "end": 40.37, "label": "Efeonce AEO."}, {"id": "speech-11", "time": 40.42, "end": 42.94, "label": "Mide tu visibilidad en los motores de respuesta de IA"}, {"id": "speech-12", "time": 42.99, "end": 44.96, "label": "con nuestro AI Visibility Report."}],tracks:[{src:'/preview-media/sparks-es.vtt',language:'es',label:'Español',kind:'subtitles' as const}]}
---
<BaseLayout title="Video player | Efeonce Think" description="Demostración del reproductor compartido AXIS dentro de Think." noindex analytics={false}>
<main class="video-preview" style={`--ink:${axis.accent[900]};--paper:${axis.gray[50]};--line:${axis.gray[200]}`}>
<header><a href="/" aria-label="Efeonce Think"><img src="/branding/efeonce-logo.svg" alt="Efeonce" width="140" /></a><span>Think · Vista previa</span></header>
<article><p>De una idea a una decisión.</p><h1>El contenido también se puede ver.</h1><p>Una explicación en el mismo lugar donde exploras la evidencia. Sin salir del informe ni perder el contexto.</p>
<AxisVideoPlayer model={model} options={{loading:'visible',doubleTapSeek:true}}/>
<p class="caption">Demostración de integración · Los Sparks. Este clip prueba la interfaz; no añade contenido a informes de clientes.</p>
<h2>Continúa con el contexto.</h2><p>El reproductor ocupa únicamente el espacio del video. El título, los capítulos y la transcripción se incorporan cuando el producto los necesita.</p>
</article>
</main>
</BaseLayout>
<style>
.video-preview{color:var(--ink);background:var(--paper);min-height:100vh;padding:clamp(1rem,4vw,3rem);font-family:Poppins,system-ui,sans-serif}.video-preview header{display:flex;align-items:center;justify-content:space-between;gap:1rem;max-width:70rem;margin:0 auto 4rem;padding-bottom:1.5rem;border-bottom:1px solid var(--line)}.video-preview article{max-width:52rem;margin:auto}.video-preview h1{font-size:clamp(2rem,5vw,3.6rem);line-height:1.08;letter-spacing:-.04em;margin:1rem 0 1.5rem}.video-preview h2{font-size:1.8rem;line-height:1.2;margin:2rem 0 1rem}.video-preview p{line-height:1.7;margin:1rem 0 2rem}.video-preview .caption{font-size:.8rem;margin-top:.8rem}.video-preview :global(.axis-video){margin-top:2rem}
</style>
