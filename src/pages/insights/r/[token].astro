---
/**
 * Informe compartido de Efeonce Insights — `think.efeoncepro.com/insights/r/<token>` (TASK-1875, greenhouse-eo).
 *
 * Dirección «tablero de respuestas» (aprobada por el operador 2026-09-28): no es el PDF animado. Abre con la
 * respuesta; los hallazgos se exploran y se expanden en su lugar; la barra fija filtra por módulo y su órbita marca el
 * avance de la lectura; el gráfico principal de cada módulo se narra en escena.
 *
 * Render tonto de `InsightWebModelV1` (TASK-1848). Resolución por request, sin cache: revocar revoca en la lectura
 * siguiente. El token vive sólo en la URL y en el fetch SSR: nunca en el HTML (canonical genérico, descargas por query
 * relativa, enlaces copiados desde `location`), ni en analytics (sin GTM) ni en el Referer (`no-referrer`).
 */
export const prerender = false


import BaseLayout from '@layouts/BaseLayout.astro'
import StatusScreen from '@/components/primitives/StatusScreen.astro'
import InsightReport from '@/components/insights/InsightReport.astro'
import { fetchSharedInsightEdition, fetchSharedInsightLogo, fetchSharedInsightOutput, type InsightOutput } from '@lib/insights'
import { getInsightsCopy } from '@lib/insights-copy'

const token = Astro.params.token ?? ''

Astro.response.headers.set('Cache-Control', 'private, no-store')
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow')
Astro.response.headers.set('Referrer-Policy', 'no-referrer')

// Logo del cliente (1.1): `?logo=1` en la MISMA URL; Greenhouse aplica el mismo gate del token.
if (Astro.url.searchParams.get('logo') === '1') {
  const upstream = await fetchSharedInsightLogo(token)
  if (upstream.ok && upstream.body) {
    const type = upstream.headers.get('content-type') ?? 'image/png'
    return new Response(upstream.body, { status: 200, headers: { 'Content-Type': type, 'Cache-Control': 'private, no-store', 'X-Robots-Tag': 'noindex, nofollow', 'Referrer-Policy': 'no-referrer', 'X-Content-Type-Options': 'nosniff' } })
  }
  return new Response(null, { status: 404, headers: { 'Cache-Control': 'private, no-store' } })
}

// Descarga: `?descargar=<output>` en la MISMA URL, así el HTML nunca escribe el token. Greenhouse revalida el grant.
const requested = Astro.url.searchParams.get('descargar')
if (requested === 'report_pdf' || requested === 'deck_pdf') {
  const upstream = await fetchSharedInsightOutput(token, requested as InsightOutput)
  if (upstream.ok && upstream.body) {
    const headers = new Headers({ 'Cache-Control': 'private, no-store', 'X-Robots-Tag': 'noindex, nofollow', 'Referrer-Policy': 'no-referrer' })
    for (const name of ['content-type', 'content-disposition', 'content-length']) {
      const value = upstream.headers.get(name)
      if (value) headers.set(name, value)
    }
    return new Response(upstream.body, { status: 200, headers })
  }
  // Sin archivo (revocado, expirado, aún no generado): de vuelta al informe, que muestra el estado real.
  return Astro.redirect(Astro.url.pathname, 303)
}

const result = token ? await fetchSharedInsightEdition(token) : ({ status: 'not_found' } as const)

if (result.status === 'not_found') Astro.response.status = 404
if (result.status === 'gone') Astro.response.status = 410
if (result.status === 'rate_limited') Astro.response.status = 429
if (result.status === 'error') Astro.response.status = 502

const edition = result.status === 'ok' ? result.edition : null
const C = getInsightsCopy(edition?.model.locale)
const header = edition?.header
const locale = edition?.model.locale ?? 'es-CL'
const statusCopy = result.status !== 'ok' ? C.states[result.status] : null
---

<BaseLayout
  title={header ? `${header.reportTitle} · Efeonce Insights` : 'Efeonce Insights'}
  description={C.ogDescription}
  noindex
  canonical="/insights"
  analytics={false}
  lang={locale}
  ogImage="/branding/insights/og-insights.png"
  ogImageAlt="Efeonce Insights"
>
  {statusCopy ? (
    <main>
      <StatusScreen
        kind={result.status as 'not_found' | 'gone' | 'rate_limited' | 'error'}
        eyebrow={statusCopy.eyebrow}
        title={statusCopy.title}
        body={statusCopy.body}
        {...(result.status === 'not_found' || result.status === 'gone' ? { ctaLabel: C.contactCta, ctaHref: 'mailto:sales@efeoncepro.com' } : {})}
      />
    </main>
  ) : edition && <InsightReport edition={edition} />}
</BaseLayout>
