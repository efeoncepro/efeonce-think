---
import BaseLayout from '@layouts/BaseLayout.astro'
import { axis } from '@lib/report-tokens'
---

<BaseLayout
  title="Efeonce Think — Herramientas de visibilidad"
  description="Hub de herramientas de Efeonce para medir y mejorar tu visibilidad en la era de la IA."
>
  <main
    class="home-hero"
    data-capture="home-hero"
    style={`--axis-navy-soft:${axis.accent[800]};--axis-navy:${axis.accent[900]};--axis-legal-ink:${axis.gray[200]};`}
  >
    <img class="think-mark" src="/branding/eo-think-2.svg" alt="Efeonce Think" />
    <footer class="home-legal" data-efeonce-legal-links aria-label="Enlaces legales">
      <a href="https://efeoncepro.com/politica-de-privacidad/">Privacidad</a>
    </footer>
  </main>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100dvh;
    padding: clamp(2rem, 6vw, 5rem);
    /* Mismo degradado que el hero del report de Brand Visibility */
    background: linear-gradient(160deg, var(--axis-navy-soft) 0%, var(--axis-navy) 62%, #001a33 100%);
  }

  .think-mark {
    width: min(520px, 68vw);
    height: auto;
  }

  .home-legal {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    color: var(--axis-legal-ink);
    font-size: 0.75rem;
    line-height: 1.6;
  }
  .home-legal a { color: inherit; }
  .home-legal a:hover { text-decoration: underline; }

  @media (max-width: 640px) {
    .think-mark {
      width: min(340px, 78vw);
    }
  }
</style>
