---
import '@fontsource/poppins/300.css'
import '@fontsource/poppins/400.css'
import '@fontsource/poppins/500.css'
import '@fontsource/poppins/600.css'
import '@fontsource-variable/bricolage-grotesque/opsz.css'
import BaseLayout from '@layouts/BaseLayout.astro'
import BrandVisibilityFormDock from '@/components/BrandVisibilityFormDock.astro'
import EfeonceSlogan from '@/components/EfeonceSlogan.astro'
import EngineAvatarGroup from '@/components/primitives/EngineAvatarGroup.astro'
import EngineHeroOrbit from '@/components/EngineHeroOrbit.astro'
import AIVisibilityReportSample from '@/components/AIVisibilityReportSample.astro'
import { buildCopyrightNotice } from '@lib/legal'
import { axis, LEVEL_COPY } from '@lib/report-tokens'
import { engine, landingCssVars, slogan, sloganFontPx } from '@lib/ai-visibility-landing-tokens'

const productName = 'Efeonce AI Visibility Report'
const pageTitle = `${productName} · ¿Te recomiendan las IA?`
const pageDescription =
  'Mide cómo ChatGPT, Claude, Gemini, Perplexity y Google entienden, citan y recomiendan tu marca. Recibe tu AI Visibility Report con acciones.'
const siteUrl = 'https://think.efeoncepro.com'
const organizationUrl = 'https://efeoncepro.com'
const landingUrl = `${siteUrl}/brand-visibility`
const organizationId = `${organizationUrl}/#organization`
const websiteId = `${siteUrl}/#website`
const webpageId = `${landingUrl}#webpage`
const serviceId = `${landingUrl}#service`
const engines = ['chatgpt', 'gemini', 'claude', 'perplexity', 'google_ai_overview']
const levels = [
  {
    key: 'found',
    signal: 'Acceso, indexación, robots y cobertura por canal.',
    diagnostic: 'Si no te encuentran, todo lo demás queda fuera de juego.',
  },
  {
    key: 'readable',
    signal: 'Estructura semántica, schema, contenido y señales legibles.',
    diagnostic: 'Si te leen con ambigüedad, completan los vacíos por ti.',
  },
  {
    key: 'correct',
    signal: 'Exactitud, claims, categoría y confusión competitiva.',
    diagnostic: 'El riesgo no es sólo no aparecer; también es que una respuesta te describa mal.',
  },
  {
    key: 'actionable',
    signal: 'Acciones, rutas claras, datos útiles y experiencia operable.',
    diagnostic: 'La próxima frontera es que un agente pueda usar tu sitio, no sólo citarlo.',
  },
  {
    key: 'intrinsic',
    signal: 'Autoridad de entidad, preferencia y share of voice sostenido.',
    diagnostic: 'Ser el default se gana con consistencia, no con un ajuste aislado.',
  },
] as const
// Íconos Trazo de AXIS (voz de la línea Engine, en reposo: la página ya cierra con esferas). Archivos oficiales en
// `public/branding/icons/trazo-<glifo>.svg`, exportados con `pnpm insights:think-icons` en greenhouse-eo.
const frameworkGlyphs = {
  found: 'busqueda',
  readable: 'contenido',
  correct: 'checklist',
  actionable: 'web',
  intrinsic: 'objetivo',
} as const
const brandVisibilityJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Efeonce Group SpA',
      alternateName: 'Efeonce',
      url: organizationUrl,
      logo: `${siteUrl}/branding/efeonce-logo.svg`,
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: 'Efeonce Think',
      url: siteUrl,
      inLanguage: 'es-CL',
      publisher: {
        '@id': organizationId,
      },
    },
    {
      '@type': 'WebPage',
      '@id': webpageId,
      url: landingUrl,
      name: pageTitle,
      headline: '¿Te recomiendan las IA? Averígualo.',
      description: pageDescription,
      inLanguage: 'es-CL',
      isPartOf: {
        '@id': websiteId,
      },
      about: {
        '@id': serviceId,
      },
      mainEntity: {
        '@id': serviceId,
      },
      breadcrumb: {
        '@id': `${landingUrl}#breadcrumb`,
      },
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: productName,
      alternateName: 'Brand Visibility Grader',
      serviceType: 'Análisis de visibilidad en motores de respuesta y búsqueda generativa',
      category: ['AEO', 'GEO', 'Brand visibility', 'Answer Engine Optimization'],
      description:
        'Diagnóstico de Efeonce para evaluar presencia, citabilidad, exactitud y operabilidad de una marca en motores de respuesta y superficies generativas de búsqueda.',
      provider: {
        '@id': organizationId,
      },
      audience: {
        '@type': 'BusinessAudience',
        audienceType: 'Equipos de marketing, crecimiento, dirección y estrategia digital',
      },
      potentialAction: {
        '@type': 'Action',
        name: 'Solicitar mi AI Visibility Report',
        target: `${landingUrl}#brand-visibility-form`,
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${landingUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Efeonce Think',
          item: siteUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: productName,
          item: landingUrl,
        },
      ],
    },
    {
      '@type': 'ItemList',
      '@id': `${landingUrl}#framework`,
      name: 'Framework Efeonce de visibilidad en motores de respuesta',
      itemListElement: levels.map((level, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: `${LEVEL_COPY[level.key].labelEn}: ${LEVEL_COPY[level.key].label}`,
        description: level.signal,
      })),
    },

  ],
} as const
const footerCopyrightNotice = buildCopyrightNotice()
// Bloque de firma: el eslogan es un gráfico al 64 % del ancho del logo (logo negativo: 837,07 × 196,68).
const footerLogoHeightPx = 44
const footerLogoWidthPx = Number(((footerLogoHeightPx * 837.07) / 196.68).toFixed(2))
const footerSloganPx = sloganFontPx(footerLogoWidthPx)
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="/brand-visibility"
  jsonLd={brandVisibilityJsonLd}
>
  <main
    class="brand-visibility-page"
    data-capture="brand-visibility-landing"
    style={`${landingCssVars};--axis-blue:${axis.accent[500]};--axis-blue-dark:${axis.accent[700]};--axis-navy:${axis.accent[900]};--axis-navy-soft:${axis.accent[800]};--axis-success:${axis.success[500]};--axis-warning:${axis.warning[500]};--axis-gray-50:${axis.gray[50]};--axis-gray-100:${axis.gray[100]};--axis-gray-200:${axis.gray[200]};--axis-gray-600:${axis.gray[600]};--axis-gray-800:${axis.gray[800]};--axis-gray-900:${axis.gray[900]};`}
  >
    <section class="hero-shell" data-capture="brand-visibility-hero" aria-labelledby="brand-visibility-title">
      <header class="topbar">
        <a class="brand-link" href="/" aria-label="Efeonce AI Visibility Report, ir a Efeonce Think">
          <img class="product-lockup" src="/branding/products/ai-visibility-report-lockup-negative.svg" alt="Efeonce AI Visibility Report" width="431" height="31" />
        </a>
      </header>

      <div class="hero-grid">
        <div class="hero-copy">
          <h1 id="brand-visibility-title">
            <span class="hero-question"><span class="hero-ring" aria-hidden="true"></span>¿Te recomiendan las IA?</span>
            <span class="hero-answer">Averígualo<span class="hero-sphere" aria-hidden="true"></span></span>
          </h1>
          <p class="hero-lead">
            Descubre cómo aparece tu marca, quién aparece en su lugar
            y <strong>qué mejorar primero.</strong>
          </p>

          <div class="engine-chips" data-capture="brand-visibility-signal-preview" aria-label="Motores de respuesta y superficies generativas analizadas">
            <EngineAvatarGroup providers={engines} size="md" max={5} />
          </div>

        </div>
        <EngineHeroOrbit />
        <div class="hero-cta-row">
          <a class="hero-cta" href="#brand-visibility-form">Empezar mi análisis <span aria-hidden="true">→</span></a>
          <p class="hero-cta-note">Informe en pantalla y descarga en PDF.</p>
        </div>
      </div>

      <BrandVisibilityFormDock />
    </section>

    <section class="framework-band" data-capture="brand-visibility-trust" aria-labelledby="framework-title">
      <div class="framework-heading">
        <p class="section-kicker framework-kicker">
          <span>Framework de</span>
          <span class="inline-efeonce-logo" role="img" aria-label="Efeonce"></span>
        </p>
        <h2 id="framework-title">La visibilidad en IA se gana capa por capa.</h2>
        <p>
          El informe ordena el diagnóstico en cinco niveles: acceso, lectura,
          exactitud, operabilidad y preferencia de marca.
        </p>
      </div>

      <ol class="framework-ladder" aria-label="Cinco niveles de visibilidad en IA, motores de respuesta y búsqueda generativa">
        {levels.map((level) => {
          return (
            <li>
              <details class="method-detail">
                <summary>
                  <span class="method-number">{LEVEL_COPY[level.key].ordinal}</span>
                  <span class="method-title">
                    <span class="method-question">{LEVEL_COPY[level.key].question}</span>
                    <span class="method-subtitle">{LEVEL_COPY[level.key].label} · {LEVEL_COPY[level.key].labelEn}</span>
                  </span>
                  <img src={`/branding/icons/trazo-${frameworkGlyphs[level.key]}.svg`} alt="" width="24" height="24" />
                  <span class="method-expand" aria-hidden="true">+</span>
                </summary>
                <div class="method-answer"><p>{level.signal}</p><p>{level.diagnostic}</p></div>
              </details>
            </li>
          )
        })}
      </ol>

    </section>

    <AIVisibilityReportSample />

    <section class="decision-section" aria-labelledby="decision-title">
      <div class="decision-copy">
        <p class="section-kicker">Antes de empezar</p>
        <h2 id="decision-title">Tu marca, con más claridad.</h2>
        <p>Obtén una lectura de tu presencia en IA y un siguiente paso respaldado por las señales del análisis.</p>
        <a class="hero-cta final-cta" href="#brand-visibility-form" data-start-analysis>Empezar mi análisis <span aria-hidden="true">→</span></a>
      </div>
      <div class="decision-questions">
        <details open><summary>¿Qué voy a recibir?</summary><p>Un informe con puntaje, presencia por motor, brechas y acciones priorizadas. Cuando una señal no tiene datos suficientes, se indica en el resultado.</p></details>
        <details><summary>¿Cómo veo y descargo el informe?</summary><p>Cuando termine el análisis, el informe se abrirá en esta pestaña. Desde el resultado puedes descargar su versión en PDF.</p></details>
        <details><summary>¿Para qué necesitan mi correo?</summary><p>Usamos tu correo corporativo para la entrega y recuperación del informe, según el consentimiento que aceptas al enviar la solicitud.</p></details>
        <details><summary>¿Quién puede acceder al resultado?</summary><p>El informe se abre mediante un enlace de acceso y no se indexa en buscadores. Quien tenga ese enlace puede consultarlo: compártelo sólo con las personas que deban verlo.</p></details>
      </div>
    </section>

    <footer class="report-footer brand-visibility-footer" data-capture="brand-visibility-footer">
      <div class="report-footer-shell">
        <div class="report-footer-brand">
          <a href="https://efeoncepro.com" target="_blank" rel="noopener noreferrer" aria-label="Ir a efeoncepro.com">
            <img src="/branding/efeonce-logo-negative.svg" alt="Efeonce" width={footerLogoWidthPx} height={footerLogoHeightPx} />
          </a>
          <span class="footer-slogan" style={`width:${(slogan.ofLogo * footerLogoWidthPx).toFixed(2)}px;margin-top:${(slogan.gapOfFont * footerSloganPx).toFixed(2)}px`}>
            <EfeonceSlogan word={slogan.word} color={engine.sloganLeadOnDark} wordColor={engine.ink} size={`${footerSloganPx}px`} />
          </span>
        </div>
        <div class="report-footer-column">
          <p class="report-footer-kicker">Propiedad intelectual</p>
          <p class="report-footer-strong">{footerCopyrightNotice}</p>
          <p>Todos los derechos reservados.</p>
        </div>
        <div class="report-footer-column report-footer-aeo">
          <img class="footer-aeo-logo" src="/branding/products/aeo-logo-negative.svg" alt="Efeonce AEO" width="79" height="28" loading="lazy" />
          <p>¿Quieres mejorar tu visibilidad en las respuestas de IA?</p>
          <a href="https://efeoncepro.com/aeo-2/" target="_blank" rel="noopener noreferrer" class="report-footer-link">
            Conoce nuestros servicios de AEO <span aria-hidden="true">→</span>
          </a>
        </div>
        <p class="report-footer-disclaimer">
          Lectura agregada y asistida por modelos generativos. Orienta decisiones;
          no garantiza posiciones, menciones ni resultados comerciales.
        </p>
      </div>
    </footer>
  </main>
</BaseLayout>

<script>
  // Conserva el destino en la URL y anuncia el encabezado al navegar con teclado o lector de pantalla.
  document.querySelectorAll<HTMLAnchorElement>('.hero-cta, [data-start-analysis]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
      const targetId = link.hash === '#brand-visibility-form' ? 'brand-visibility-form-title' : 'framework-title'
      const heading = document.getElementById(targetId)
      const target = document.querySelector(link.hash)
      if (!heading || !target) return
      event.preventDefault()
      window.history.pushState(null, '', link.hash)
      target.scrollIntoView({ block: 'start' })
      heading.setAttribute('tabindex', '-1')
      heading.focus({ preventScroll: true })
    })
  })
</script>

<style>
  :global(html) {
    scroll-behavior: auto;
  }

  .brand-visibility-page {
    --brand-shell-width: min(1360px, calc(100% - clamp(2rem, 4vw, 4rem)));
    --brand-form-card-radius: clamp(1rem, 1.7vw, 1.55rem);
    --brand-hero-bottom-radius: 0;
    min-height: 100vh;
    overflow-x: clip;
    background: var(--engine-paper);
    color: var(--engine-paper-ink);
    font-family: 'Poppins', sans-serif;
  }

  /* ── Hero «La órbita», línea Engine (TASK-1966). Valores: @lib/ai-visibility-landing-tokens. ── */
  .hero-shell {
    --hero-inset: max(1rem, 6.667vw); /* surfaces.web.chrome.desktop.textInsetOfWidth */
    position: relative;
    isolation: isolate;
    overflow: visible;
    background: var(--engine-ground);
    color: var(--engine-ink);
  }

  .topbar,
  .framework-band {
    width: var(--brand-shell-width);
    margin-inline: auto;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(28px, 3.3vw, 48px) clamp(20px, 2.5vw, 32px) 0;
  }

  .brand-link {
    display: inline-flex;
    border-radius: 4px;
    line-height: 0;
  }

  .product-lockup {
    display: block;
    width: auto;
    height: 34px;
  }

  .brand-link:focus-visible,
  .hero-cta:focus-visible {
    outline: 2px solid var(--engine-ink);
    outline-offset: 4px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    column-gap: clamp(24px, 4vw, 64px);
    width: var(--brand-shell-width);
    margin-inline: auto;
    padding: clamp(40px, 3.4vw, 48px) clamp(20px, 2.5vw, 32px) calc(clamp(5.8rem, 9vw, 8rem) + 48px);
    overflow: clip;
  }
  /* Bound the square scene: its width is also its height and must not grow with an ultrawide viewport. */
  .hero-grid > :global(.hero-orbit) { grid-column: 2; grid-row: 1 / 3; align-self: center; justify-self: center; width: 100%; max-width: 500px; }
  .hero-grid > .hero-copy { align-self: end; }
  .hero-grid > .hero-cta-row { align-self: start; grid-column: 1; }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    width: min(660px, 100%);
    min-width: 0;
  }

  .hero-copy h1 {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 0;
    color: var(--engine-ink);
  }

  .hero-question {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1.375rem, 2.08vw, 1.875rem);
    font-weight: 300;
    line-height: 1.2;
  }

  /* El anillo de la línea como viñeta: fino, en el acento, nunca un disco. */
  .hero-ring {
    display: inline-block;
    width: 0.42em;
    height: 0.42em;
    margin-right: 0.35em;
    border: max(1px, 0.06em) solid var(--engine-accent);
    border-radius: 50%;
    vertical-align: 0.08em;
    box-sizing: border-box;
  }

  .hero-answer {
    font-family: 'Bricolage Grotesque Variable', 'Bricolage Grotesque', sans-serif;
    font-size: clamp(3.4rem, 7.8vw, 7.5rem); /* respuesta ≥ 3× la pregunta en todo ancho */
    font-weight: 760;
    letter-spacing: -0.035em;
    line-height: 0.92;
    white-space: nowrap;
  }

  /* La esfera cierra la palabra y es parte del texto. */
  .hero-sphere {
    display: inline-block;
    width: 0.2em;
    height: 0.2em;
    margin-left: 0.035em;
    border-radius: 50%;
    background: var(--engine-accent);
  }

  .hero-lead {
    max-width: 540px;
    margin: 10px 0 0;
    color: var(--engine-ink-soft);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .hero-lead strong {
    color: var(--engine-ink);
    font-weight: 600;
  }

  .engine-chips {
    margin-top: 6px;
  }

  .engine-chips :global(.engine-avatar-group) {
    padding-block: 0;
  }

  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 18px;
    margin-top: 18px;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
    border-radius: 999px;
    padding: 18px 32px;
    background: var(--engine-ink);
    color: var(--engine-ground);
    font-size: 1.0625rem;
    font-weight: 600;
    text-decoration: none;
    border: 2px solid transparent;
    transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .hero-cta:hover {
    background: var(--engine-ink-soft);
    border-color: var(--engine-accent);
    box-shadow: 0 0 0 4px color-mix(in srgb,var(--engine-accent) 20%,transparent);
  }
  .hero-cta span { transition: transform 180ms ease; }
  .hero-cta:hover span, .hero-cta:focus-visible span { transform: translateX(4px); }
  .hero-cta:active { box-shadow: inset 0 0 0 2px var(--engine-accent); }

  .hero-cta-note {
    margin: 0;
    color: var(--engine-ink-soft);
    font-size: 0.875rem;
  }

  .preview-icon {
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    border: 1px solid var(--engine-line);
    border-radius: 8px;
    background: var(--engine-paper);
    color: var(--engine-paper-ink);
  }





  .section-kicker { margin: 0 0 .8rem; color: var(--engine-paper-ink-soft); font-size: .8rem; font-weight: 500; }
  .framework-band { width: var(--brand-shell-width); margin-inline: auto; padding: var(--brand-form-dock-clearance,clamp(9rem,12vw,14rem)) 0 clamp(3rem,6vw,5rem); display: grid; grid-template-columns: minmax(0,.8fr) minmax(0,1.2fr); gap: clamp(2rem,5vw,5rem); align-items: start; }
  .framework-kicker { display: flex; align-items: center; gap: .4rem; }
  .inline-efeonce-logo { display: inline-block; width: 66px; height: 18px; background: var(--engine-paper-ink); mask: url('/branding/efeonce-logo-negative.svg') center / contain no-repeat; }
  .framework-heading h2,.decision-copy h2 { font-family: 'Bricolage Grotesque Variable',sans-serif; color: var(--engine-paper-ink); font-size: clamp(1.8rem,3vw,2.7rem); font-weight: 600; letter-spacing: -.025em; line-height: 1.12; margin: 0; }
  .framework-heading > p:last-child,.decision-copy > p:not(.section-kicker) { color: var(--engine-paper-ink-soft); font-size: .95rem; line-height: 1.75; margin: 1.25rem 0 0; }
  .framework-ladder { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--engine-line); }
  .framework-ladder > li { border-bottom: 1px solid var(--engine-line); }
  .method-detail summary { display: grid; grid-template-columns: 1.5rem minmax(0,1fr) 24px 16px; gap: 1rem; align-items: center; padding: 1.3rem 0; cursor: pointer; list-style: none; }
  .method-detail summary::-webkit-details-marker { display: none; }
  .method-number { font-size: .75rem; color: var(--engine-paper-ink-soft); }
  .method-question { display: block; font-size: 1rem; line-height: 1.4; font-weight: 500; color: var(--engine-paper-ink); }
  .method-subtitle { display: block; font-size: .75rem; line-height: 1.5; margin-top: .35rem; color: var(--engine-paper-ink-soft); }
  .method-expand { font-size: 1.4rem; font-weight: 300; }
  .method-detail[open] .method-expand { transform: rotate(45deg); }
  .method-answer { padding: 0 2rem 1.25rem 2.5rem; font-size: .85rem; color: var(--engine-paper-ink-soft); line-height: 1.7; }
  .method-answer p { margin: 0 0 .5rem; }
  .decision-section { width: var(--brand-shell-width); margin-inline: auto; padding-block: clamp(3rem,6vw,6rem); display: grid; grid-template-columns: minmax(0,.8fr) minmax(0,1.2fr); gap: clamp(2rem,5vw,5rem); }
  .final-cta { margin-top: 1.75rem; background: var(--engine-ground); color: var(--engine-ink); }
  .final-cta:hover { background: var(--engine-paper-ink); color: var(--engine-ink); }
  .decision-questions details { border-bottom: 1px solid var(--engine-line); padding-block: 1.15rem; }
  .decision-questions details:first-child { border-top: 1px solid var(--engine-line); }
  .decision-questions summary { font-size: .95rem; font-weight: 500; cursor: pointer; color: var(--engine-paper-ink); }
  .decision-questions p { font-size: .85rem; line-height: 1.75; color: var(--engine-paper-ink-soft); margin: .75rem 0 0; }
  #framework-title { scroll-margin-top: 24px; }
  summary:focus-visible { outline: 2px solid var(--engine-accent); outline-offset: 4px; }

  .brand-visibility-footer {
    background: var(--engine-ground);
  }

  .brand-visibility-footer::before {
    content: none;
  }

  .report-footer-brand {
    align-items: center;
    gap: 0;
  }

  .report-footer-brand > a {
    display: block;
    line-height: 0;
  }

  .footer-slogan {
    display: flex;
    justify-content: center;
    line-height: 1;
