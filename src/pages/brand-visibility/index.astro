---
import '@fontsource/poppins/300.css'
import '@fontsource/poppins/400.css'
import '@fontsource/poppins/500.css'
import '@fontsource/poppins/600.css'
import '@fontsource-variable/bricolage-grotesque/opsz.css'
import BaseLayout from '@layouts/BaseLayout.astro'
import BrandVisibilityFormDock from '@/components/BrandVisibilityFormDock.astro'
import EfeonceSlogan from '@/components/EfeonceSlogan.astro'
import EngineAvatarGroup from '@/components/primitives/EngineAvatarGroup.astro'
import EngineHeroOrbit from '@/components/EngineHeroOrbit.astro'
import { buildCopyrightNotice } from '@lib/legal'
import { axis, LEVEL_COPY } from '@lib/report-tokens'
import { engine, landingCssVars, slogan, sloganFontPx } from '@lib/ai-visibility-landing-tokens'

const productName = 'Efeonce AI Visibility Report'
const pageTitle = `${productName} · ¿Te recomiendan las IA?`
const pageDescription =
  'Mide cómo ChatGPT, Claude, Gemini, Perplexity y Google entienden, citan y recomiendan tu marca. Recibe tu AI Visibility Report con acciones.'
const siteUrl = 'https://think.efeoncepro.com'
const organizationUrl = 'https://efeoncepro.com'
const landingUrl = `${siteUrl}/brand-visibility`
const organizationId = `${organizationUrl}/#organization`
const websiteId = `${siteUrl}/#website`
const webpageId = `${landingUrl}#webpage`
const serviceId = `${landingUrl}#service`
const engines = ['chatgpt', 'gemini', 'claude', 'perplexity', 'google_ai_overview']
const previewModules = [
  {
    title: 'Mapa de presencia',
    glyph: 'ubicacion',
    tone: 'presence',
    label: 'Dónde apareces',
    body: 'Identifica qué canales recuperan tu marca, con qué frecuencia y frente a qué alternativas de la categoría.',
  },
  {
    title: 'Lectura competitiva',
    glyph: 'prensa',
    tone: 'citation',
    label: 'Por qué te citan',
    body: 'Muestra qué fuentes sostienen la confianza, qué señales faltan y qué competidores están ganando la respuesta.',
  },
  {
    title: 'Exactitud de marca',
    glyph: 'ia',
    tone: 'category',
    label: 'Qué interpreta cada canal',
    body: 'Detecta si tu oferta se entiende con precisión o si el motor mezcla claims, categorías o competidores.',
  },
  {
    title: 'Prioridad de acción',
    glyph: 'medicion',
    tone: 'operability',
    label: 'Qué mejorar primero',
    body: 'Ordena el siguiente movimiento: corregir presencia, estructura, narrativa, exactitud o capacidad operable.',
  },
] as const
const levels = [
  {
    key: 'found',
    signal: 'Acceso, indexación, robots y cobertura por canal.',
    diagnostic: 'Si no te encuentran, todo lo demás queda fuera de juego.',
  },
  {
    key: 'readable',
    signal: 'Estructura semántica, schema, contenido y señales legibles.',
    diagnostic: 'Si te leen con ambigüedad, completan los vacíos por ti.',
  },
  {
    key: 'correct',
    signal: 'Exactitud, claims, categoría y confusión competitiva.',
    diagnostic: 'El riesgo no es sólo no aparecer; también es que una respuesta te describa mal.',
  },
  {
    key: 'actionable',
    signal: 'Acciones, rutas claras, datos útiles y experiencia operable.',
    diagnostic: 'La próxima frontera es que un agente pueda usar tu sitio, no sólo citarlo.',
  },
  {
    key: 'intrinsic',
    signal: 'Autoridad de entidad, preferencia y share of voice sostenido.',
    diagnostic: 'Ser el default se gana con consistencia, no con un ajuste aislado.',
  },
] as const
// Íconos Trazo de AXIS (voz de la línea Engine, en reposo: la página ya cierra con esferas). Archivos oficiales en
// `public/branding/icons/trazo-<glifo>.svg`, exportados con `pnpm insights:think-icons` en greenhouse-eo.
const frameworkGlyphs = {
  found: 'busqueda',
  readable: 'contenido',
  correct: 'checklist',
  actionable: 'web',
  intrinsic: 'objetivo',
} as const
const reportProofPoints = [
  {
    title: 'Privado',
    body: 'El resultado se abre en una ruta no indexable para revisión interna.',
  },
  {
    title: 'Con evidencia',
    body: 'Sólo muestra hallazgos cuando hay señales suficientes para sostenerlos.',
  },
  {
    title: 'Con siguiente paso',
    body: 'Separa diagnóstico, riesgo y acción recomendada para decidir qué corregir primero.',
  },
] as const
const reportSignals = [
  {
    label: 'Presencia',
    value: 'dónde te recuperan',
  },
  {
    label: 'Citabilidad',
    value: 'por qué te nombran',
  },
  {
    label: 'Acción',
    value: 'qué corregir primero',
  },
] as const
const brandVisibilityJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Efeonce Group SpA',
      alternateName: 'Efeonce',
      url: organizationUrl,
      logo: `${siteUrl}/branding/efeonce-logo.svg`,
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: 'Efeonce Think',
      url: siteUrl,
      inLanguage: 'es-CL',
      publisher: {
        '@id': organizationId,
      },
    },
    {
      '@type': 'WebPage',
      '@id': webpageId,
      url: landingUrl,
      name: pageTitle,
      headline: '¿Te recomiendan las IA? Averígualo.',
      description: pageDescription,
      inLanguage: 'es-CL',
      isPartOf: {
        '@id': websiteId,
      },
      about: {
        '@id': serviceId,
      },
      mainEntity: {
        '@id': serviceId,
      },
      breadcrumb: {
        '@id': `${landingUrl}#breadcrumb`,
      },
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: productName,
      alternateName: 'Brand Visibility Grader',
      serviceType: 'Análisis de visibilidad en motores de respuesta y búsqueda generativa',
      category: ['AEO', 'GEO', 'Brand visibility', 'Answer Engine Optimization'],
      description:
        'Diagnóstico de Efeonce para evaluar presencia, citabilidad, exactitud y operabilidad de una marca en motores de respuesta y superficies generativas de búsqueda.',
      provider: {
        '@id': organizationId,
      },
      audience: {
        '@type': 'BusinessAudience',
        audienceType: 'Equipos de marketing, crecimiento, dirección y estrategia digital',
      },
      potentialAction: {
        '@type': 'Action',
        name: 'Solicitar mi AI Visibility Report',
        target: `${landingUrl}#brand-visibility-form`,
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${landingUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Efeonce Think',
          item: siteUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: productName,
          item: landingUrl,
        },
      ],
    },
    {
      '@type': 'ItemList',
      '@id': `${landingUrl}#framework`,
      name: 'Framework Efeonce de visibilidad en motores de respuesta',
      itemListElement: levels.map((level, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: `${LEVEL_COPY[level.key].labelEn}: ${LEVEL_COPY[level.key].label}`,
        description: level.signal,
      })),
    },
    {
      '@type': 'ItemList',
      '@id': `${landingUrl}#report-modules`,
      name: 'Módulos del Efeonce AI Visibility Report',
      itemListElement: previewModules.map((module, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: module.title,
        description: module.body,
      })),
    },
  ],
} as const
const footerCopyrightNotice = buildCopyrightNotice()
// Bloque de firma: el eslogan es un gráfico al 64 % del ancho del logo (logo negativo: 837,07 × 196,68).
const footerLogoHeightPx = 44
const footerLogoWidthPx = Number(((footerLogoHeightPx * 837.07) / 196.68).toFixed(2))
const footerSloganPx = sloganFontPx(footerLogoWidthPx)
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="/brand-visibility"
  jsonLd={brandVisibilityJsonLd}
>
  <main
    class="brand-visibility-page"
    data-capture="brand-visibility-landing"
    style={`${landingCssVars};--axis-blue:${axis.accent[500]};--axis-blue-dark:${axis.accent[700]};--axis-navy:${axis.accent[900]};--axis-navy-soft:${axis.accent[800]};--axis-success:${axis.success[500]};--axis-warning:${axis.warning[500]};--axis-gray-50:${axis.gray[50]};--axis-gray-100:${axis.gray[100]};--axis-gray-200:${axis.gray[200]};--axis-gray-600:${axis.gray[600]};--axis-gray-800:${axis.gray[800]};--axis-gray-900:${axis.gray[900]};`}
  >
    <section class="hero-shell" data-capture="brand-visibility-hero" aria-labelledby="brand-visibility-title">
      <div class="hero-orbit-frame" aria-hidden="true">
        <EngineHeroOrbit />
      </div>

      <header class="topbar">
        <a class="brand-link" href="/" aria-label="Efeonce AI Visibility Report, ir a Efeonce Think">
          <img class="product-lockup" src="/branding/products/ai-visibility-report-lockup-negative.svg" alt="Efeonce AI Visibility Report" width="431" height="31" />
        </a>
        <a class="topbar-link" href="#framework-title">Cómo funciona</a>
      </header>

      <div class="hero-grid">
        <div class="hero-copy">
          <h1 id="brand-visibility-title">
            <span class="hero-question"><span class="hero-ring" aria-hidden="true"></span>¿Te recomiendan las IA?</span>
            <span class="hero-answer">Averígualo<span class="hero-sphere" aria-hidden="true"></span></span>
          </h1>
          <p class="hero-lead">
            Medimos cómo aparece tu marca en las respuestas de ChatGPT, Claude, Gemini, Perplexity y Google,
            y <strong>quién ocupa el lugar que te toca.</strong>
          </p>

          <div class="engine-chips" data-capture="brand-visibility-signal-preview" aria-label="Motores de respuesta y superficies generativas analizadas">
            <EngineAvatarGroup providers={engines} size="md" max={5} />
          </div>

          <div class="hero-cta-row">
            <a class="hero-cta" href="#brand-visibility-form">Empezar mi análisis <span aria-hidden="true">→</span></a>
            <p class="hero-cta-note">Recibes tu AI Visibility Report en pantalla.</p>
          </div>
        </div>
      </div>

      <BrandVisibilityFormDock />
    </section>

    <section class="framework-band" data-capture="brand-visibility-trust" aria-labelledby="framework-title">
      <div class="framework-heading">
        <p class="section-kicker framework-kicker">
          <span>Framework de</span>
          <span class="inline-efeonce-logo" role="img" aria-label="Efeonce"></span>
        </p>
        <h2 id="framework-title">La visibilidad en IA se gana capa por capa.</h2>
        <p>
          El informe ordena el diagnóstico en cinco niveles: acceso, lectura,
          exactitud, operabilidad y preferencia de marca.
        </p>
      </div>

      <ol class="framework-ladder" aria-label="Cinco niveles de visibilidad en IA, motores de respuesta y búsqueda generativa">
        {levels.map((level) => {
          return (
            <li>
              <div class="framework-card-body">
                <div class="framework-card-top">
                  <span class="framework-step">{LEVEL_COPY[level.key].ordinal}</span>
                  <div class="framework-card-heading">
                    <span class="framework-title-row">
                      <img class="framework-icon" src={`/branding/icons/trazo-${frameworkGlyphs[level.key]}.svg`} alt="" width="20" height="20" />
                      <strong>{LEVEL_COPY[level.key].labelEn}</strong>
                    </span>
                    <span class="framework-card-subtitle">{LEVEL_COPY[level.key].label}</span>
                  </div>
                </div>
                <p class="framework-question">{LEVEL_COPY[level.key].question}</p>
                <p>{level.signal}</p>
                <em>{level.diagnostic}</em>
              </div>
            </li>
          )
        })}
      </ol>

      <div class="framework-bridge" aria-label="Cómo interpreta Efeonce el framework">
        <div>
          <strong>La lectura útil no pregunta sólo si apareces.</strong>
          <p>
            Pregunta dónde se corta la cadena entre presencia, comprensión,
            exactitud y capacidad de ser citado o recomendado con confianza.
          </p>
        </div>
        <span aria-hidden="true">Found → Readable → Correct → Actionable → Intrinsic</span>
      </div>
    </section>

    <section class="preview-flow-section" data-capture="brand-visibility-report-preview" aria-labelledby="preview-title">
      <span class="capture-only" data-capture="brand-visibility-flow" aria-hidden="true"></span>
      <div class="preview-flow-grid">
        <article class="report-preview">
          <div class="section-heading">
            <div>
              <p class="section-kicker">Informe privado</p>
              <h2 id="preview-title">Del diagnóstico a la próxima acción</h2>
              <p>
                El reporte cruza presencia, citabilidad, exactitud y operabilidad
                para mostrar dónde tu marca se pierde, se confunde o puede ganar prioridad.
              </p>
            </div>
            <div class="report-signal-strip" aria-label="Señales principales del informe">
              {reportSignals.map((signal) => (
                <span>
                  <strong>{signal.label}</strong>
                  <small>{signal.value}</small>
                </span>
              ))}
            </div>
          </div>

          <div class="preview-report-layout">
            <div class="preview-module-strip">
              {previewModules.map((module) => (
                <div class="preview-module">
                  <div class="preview-module-top">
                    <span class="preview-icon" aria-hidden="true">
                      <img src={`/branding/icons/trazo-${module.glyph}.svg`} alt="" width="24" height="24" />
                    </span>
                    <small>{module.label}</small>
                  </div>
                  <h3>{module.title}</h3>
                  <p>{module.body}</p>
                </div>
              ))}
            </div>

            <div class="report-snapshot" aria-label="Vista conceptual del informe">
              <div class="snapshot-header">
                <img src="/branding/products/ai-visibility-report-lockup-negative.svg" alt="Efeonce AI Visibility Report" width="431" height="31" />
                <span>Qué recibirás</span>
              </div>
              <div class="snapshot-badge-row" aria-hidden="true">
                <span>Lectura ejecutiva</span>
                <span>Señal prioritaria</span>
              </div>
              <div class="snapshot-score">
                <div>
                  <small>Resultado accionable</small>
                  <strong>Presencia + precisión + siguiente paso</strong>
                </div>
              </div>
              <div class="snapshot-notes">
                <p><strong>Primero:</strong> ubicar dónde no estás siendo recuperado ni citado.</p>
                <p><strong>Luego:</strong> corregir la señal que más limita la recomendación.</p>
              </div>
            </div>
          </div>

          <div class="report-proof-row" aria-label="Características del informe">
            {reportProofPoints.map((point) => (
              <p><strong>{point.title}.</strong> {point.body}</p>
            ))}
          </div>
        </article>
      </div>
    </section>

    <footer class="report-footer brand-visibility-footer" data-capture="brand-visibility-footer">
      <div class="report-footer-shell">
        <div class="report-footer-brand">
          <a href="https://efeoncepro.com" target="_blank" rel="noopener noreferrer" aria-label="Ir a efeoncepro.com">
            <img src="/branding/efeonce-logo-negative.svg" alt="Efeonce" width={footerLogoWidthPx} height={footerLogoHeightPx} />
          </a>
          <span class="footer-slogan" style={`width:${(slogan.ofLogo * footerLogoWidthPx).toFixed(2)}px;margin-top:${(slogan.gapOfFont * footerSloganPx).toFixed(2)}px`}>
            <EfeonceSlogan word={slogan.word} color={engine.sloganLeadOnDark} wordColor={engine.ink} size={`${footerSloganPx}px`} />
          </span>
        </div>
        <div class="report-footer-column">
          <p class="report-footer-kicker">Propiedad intelectual</p>
          <p class="report-footer-strong">{footerCopyrightNotice}</p>
          <p>Todos los derechos reservados.</p>
        </div>
        <div class="report-footer-column report-footer-aeo">
          <img class="footer-aeo-logo" src="/branding/products/aeo-logo-negative.svg" alt="Efeonce AEO" width="79" height="28" loading="lazy" />
          <p>¿Quieres mejorar tu visibilidad en las respuestas de IA?</p>
          <a href="https://efeoncepro.com/aeo-2/" target="_blank" rel="noopener noreferrer" class="report-footer-link">
            Conoce nuestros servicios de AEO <span aria-hidden="true">→</span>
          </a>
        </div>
        <p class="report-footer-disclaimer">
          Lectura agregada y asistida por modelos generativos. Orienta decisiones;
          no garantiza posiciones, menciones ni resultados comerciales.
        </p>
      </div>
    </footer>
  </main>
</BaseLayout>

<script>
  // Conserva el destino en la URL y anuncia el encabezado al navegar con teclado o lector de pantalla.
  document.querySelectorAll<HTMLAnchorElement>('.hero-cta, .topbar-link').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
      const targetId = link.hash === '#brand-visibility-form' ? 'brand-visibility-form-title' : 'framework-title'
      const heading = document.getElementById(targetId)
      const target = document.querySelector(link.hash)
      if (!heading || !target) return
      event.preventDefault()
      window.history.pushState(null, '', link.hash)
      target.scrollIntoView({ block: 'start' })
      heading.setAttribute('tabindex', '-1')
      heading.focus({ preventScroll: true })
    })
  })
</script>

<style>
  :global(html) {
    scroll-behavior: auto;
  }

  .brand-visibility-page {
    --brand-shell-width: min(1360px, calc(100% - clamp(2rem, 4vw, 4rem)));
    --brand-form-card-radius: clamp(1rem, 1.7vw, 1.55rem);
    --brand-hero-bottom-radius: 0;
    min-height: 100vh;
    overflow-x: clip;
    background: var(--engine-paper);
    color: var(--engine-paper-ink);
    font-family: 'Poppins', sans-serif;
  }

  /* ── Hero «La órbita», línea Engine (TASK-1966). Valores: @lib/ai-visibility-landing-tokens. ── */
  .hero-shell {
    --hero-inset: max(1rem, 6.667vw); /* surfaces.web.chrome.desktop.textInsetOfWidth */
    position: relative;
    isolation: isolate;
    overflow: visible;
    background: var(--engine-ground);
    color: var(--engine-ink);
  }

  /* Recorta la órbita al hero sin recortar la tarjeta del formulario, que cuelga por debajo. */
  .hero-orbit-frame {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-orbit-frame :global(.hero-orbit) {
    position: absolute;
    top: clamp(64px, 7.6vw, 110px);
    left: 59.7%;
    width: 52.8%;
    max-width: none;
    height: auto;
    pointer-events: none;
    user-select: none;
  }

  .topbar,
  .preview-flow-grid,
  .framework-band {
    width: var(--brand-shell-width);
    margin-inline: auto;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: auto;
    margin: 0;
    padding: clamp(28px, 4.4vw, 64px) var(--hero-inset) 0;
  }

  .brand-link {
    display: inline-flex;
    border-radius: 4px;
    line-height: 0;
  }

  .product-lockup {
    display: block;
    width: auto;
    height: 34px;
  }

  .topbar-link {
    color: var(--engine-ink-soft);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    text-underline-offset: 4px;
  }

  .topbar-link:hover {
    color: var(--engine-ink);
    text-decoration: underline;
  }

  .brand-link:focus-visible,
  .topbar-link:focus-visible,
  .hero-cta:focus-visible {
    outline: 2px solid var(--engine-ink);
    outline-offset: 4px;
  }

  .hero-grid {
    padding: clamp(96px, 11vw, 160px) var(--hero-inset) calc(clamp(5.8rem, 9vw, 8rem) + clamp(72px, 7vw, 104px));
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    width: min(660px, 100%);
    min-width: 0;
  }

  .hero-copy h1 {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 0;
    color: var(--engine-ink);
  }

  .hero-question {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1.375rem, 2.08vw, 1.875rem);
    font-weight: 300;
    line-height: 1.2;
  }

  /* El anillo de la línea como viñeta: fino, en el acento, nunca un disco. */
  .hero-ring {
    display: inline-block;
    width: 0.42em;
    height: 0.42em;
    margin-right: 0.35em;
    border: max(1px, 0.06em) solid var(--engine-accent);
    border-radius: 50%;
    vertical-align: 0.08em;
    box-sizing: border-box;
  }

  .hero-answer {
    font-family: 'Bricolage Grotesque Variable', 'Bricolage Grotesque', sans-serif;
    font-size: clamp(4.25rem, 8.9vw, 8rem); /* respuesta ≥ 3× la pregunta en todo ancho */
    font-weight: 760;
    letter-spacing: -0.035em;
    line-height: 0.92;
    white-space: nowrap;
  }

  /* La esfera cierra la palabra y es parte del texto. */
  .hero-sphere {
    display: inline-block;
    width: 0.2em;
    height: 0.2em;
    margin-left: 0.035em;
    border-radius: 50%;
    background: var(--engine-accent);
  }

  .hero-lead {
    max-width: 540px;
    margin: 10px 0 0;
    color: var(--engine-ink-soft);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .hero-lead strong {
    color: var(--engine-ink);
    font-weight: 600;
  }

  .engine-chips {
    margin-top: 6px;
  }

  .engine-chips :global(.engine-avatar-group) {
    padding-block: 0;
  }

  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 18px;
    margin-top: 18px;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
    border-radius: 999px;
    padding: 18px 32px;
    background: var(--engine-ink);
    color: var(--engine-ground);
    font-size: 1.0625rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  .hero-cta:hover {
    background: var(--engine-ink-soft);
  }

  .hero-cta-note {
    margin: 0;
    color: var(--engine-ink-soft);
    font-size: 0.875rem;
  }

  .preview-icon {
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    border: 1px solid var(--engine-line);
    border-radius: 8px;
    background: var(--engine-paper);
    color: var(--engine-paper-ink);
  }





  .preview-flow-section {
