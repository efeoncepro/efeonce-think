---
// Muestra de trabajo: reel de la campaña «Innovar es hacerlo POSIBLE» (Sika Mexicana, licitación Wherex N.º 1164).
// Página suelta, sin índice ni analítica; se llega por el enlace o el QR de la propuesta. Retiro: borrar esta página y
// public/muestras/sika-posible-dde148ea051c/, redeploy y readback.
import '@fontsource/poppins/400.css'
import '@fontsource/poppins/600.css'
import BaseLayout from '@layouts/BaseLayout.astro'
import AxisVideoPlayer from '@/components/AxisVideoPlayer.astro'
import type { VideoPlayerModel } from '@efeoncepro/axis-ui-primitives/video-player'

export const prerender = true

const media = '/muestras/sika-posible-dde148ea051c'
// Colores de la campaña del cliente (manual de identidad POSIBLE); no son tokens de Efeonce.
const campaign = { yellow: '#FCC500', ink: '#0b0b0c' }

const model: VideoPlayerModel = {
  id: 'sika-posible-reel',
  title: 'SikaSeal-170 · El agua siempre busca una entrada',
  src: `${media}/reel.mp4`,
  poster: `${media}/poster.webp`,
  skin: 'cinema' as const,
  presentation: 'embedded' as const,
  surface: 'dark' as const,
  line: 'brand' as const,
  locale: 'es',
  aspectRatio: '9:16' as const,
  preload: 'metadata' as const,
  duration: 25,
  tracks: [{ src: `${media}/reel.es.vtt`, language: 'es', label: 'Español', kind: 'subtitles' as const }],
}
---

<BaseLayout
  title="Sika · Innovar es hacerlo POSIBLE · Reel | Efeonce Creative Studio"
  description="Reel de muestra de la campaña «Innovar es hacerlo POSIBLE», preparado por Efeonce Creative Studio para Sika Mexicana."
  noindex
  analytics={false}
>
  <main class="stage" style={`--y:${campaign.yellow};--ink:${campaign.ink}`}>
    <header class="top">
      <img src={`${media}/efeonce-creative-studio.svg`} alt="Efeonce Creative Studio" width="260" height="20" />
      <span>Propuesta creativa para Sika Mexicana · Wherex N.º 1164</span>
    </header>

    <section class="hero">
      <img class="firma" src={`${media}/posible-firma.png`} alt="Innovar es hacerlo POSIBLE. Innovar es hacerlo Sika." width="627" height="438" />
      <div class="frame">
        <AxisVideoPlayer model={model} options={{ loading: 'eager', doubleTapSeek: true }} />
      </div>
      <div class="copy">
        <p class="kicker">Reel de lanzamiento · SikaSeal®-170</p>
        <h1>El agua siempre busca una entrada.</h1>
        <p>
          Muestra de la campaña «Innovar es hacerlo POSIBLE», pensada para Instagram y con adaptación para TikTok.
        </p>
        <ul>
          <li>25 segundos</li>
          <li>Formato vertical 9:16</li>
          <li>Locución en español de México</li>
        </ul>
      </div>
    </section>

    <footer class="foot">
      <span>Material preparado por Efeonce Creative Studio para la licitación Wherex N.º 1164. Confidencial.</span>
      <a href="https://efeoncepro.com" rel="noopener">efeoncepro.com</a>
    </footer>
  </main>
</BaseLayout>

<style>
  .stage {
    min-height: 100dvh;
    box-sizing: border-box;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: clamp(1.25rem, 3vh, 2.5rem);
    padding: clamp(1rem, 3vw, 2.25rem) clamp(1rem, 4vw, 3rem);
    color: #fff;
    font-family: Poppins, system-ui, sans-serif;
    background:
      radial-gradient(60rem 40rem at 50% 42%, color-mix(in srgb, var(--y) 16%, transparent), transparent 70%),
      radial-gradient(90rem 60rem at 50% 120%, #1b1c1f, transparent 60%),
      var(--ink);
  }
  .top,
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: #c9ccd1;
  }
  .top img {
    display: block;
    height: 1.25rem;
    width: auto;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
  }
  .firma {
    justify-self: end;
    width: min(100%, 22rem);
    height: auto;
  }
  .frame {
    width: min(78dvh * 9 / 16, 26rem);
    border-radius: 1.25rem;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.12),
      0 2.5rem 6rem rgb(0 0 0 / 0.7),
      0 0 7rem color-mix(in srgb, var(--y) 22%, transparent);
  }
  .frame :global(.axis-video) {
    border-radius: 1.25rem;
    overflow: hidden;
  }
  .copy {
    max-width: 24rem;
  }
  .kicker {
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--y);
  }
  h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.75rem, 2.6vw, 2.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .copy p:not(.kicker) {
    margin: 0 0 1.25rem;
    font-size: 1rem;
    line-height: 1.6;
    color: #d6d8dc;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  li {
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    background: rgb(255 255 255 / 0.08);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
  }
  .foot a {
    color: #fff;
    text-decoration: none;
    font-weight: 600;
  }
  .foot a:hover,
  .foot a:focus-visible {
    text-decoration: underline;
  }
  @media (max-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      text-align: center;
      gap: 1.5rem;
    }
    .firma {
      justify-self: center;
      width: min(70%, 15rem);
    }
    .frame {
      width: min(100%, 24rem);
    }
    ul {
      justify-content: center;
    }
    .top,
    .foot {
      flex-direction: column;
      text-align: center;
      gap: 0.5rem;
    }
  }
</style>
