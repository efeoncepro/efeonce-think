---
/**
 * Escena de un módulo del informe de Insights (TASK-1875, dirección «tablero de respuestas»).
 *
 * La figura principal (la primera con lectura) se narra: el gráfico queda fijo mientras los pasos avanzan —cifra
 * principal, conclusión, lo que significa, próximo paso— y el gráfico cambia de estado con cada uno. Las demás
 * figuras, las afirmaciones, los hechos sueltos y los límites siguen debajo, compactos. Sin JS se lee de corrido.
 */
import ChartFigure from './ChartFigure.astro'
import EngineMark from '@/components/EngineMark.astro'
import { insightIconFor } from '@lib/insights-icons'
import FactMark from './FactMark.astro'
import type { InsightWebChapterV1, InsightWebFactV1 } from '@lib/insights'
import { INSIGHTS_COPY, type InsightsCopy } from '@lib/insights-copy'
import { chartFactIds } from '@lib/insights-view'

interface Props {
  chapter: InsightWebChapterV1
  index: number
  facts: Record<string, InsightWebFactV1>
  locale: string
  copy?: InsightsCopy
}

const { chapter, index, facts, locale, copy } = Astro.props
const C = copy ?? INSIGHTS_COPY
const number = String(index).padStart(2, '0')
const shortDate = (iso: string | null) => (iso ? iso.slice(0, 10).split('-').reverse().join('-') : null)

const mainIndex = chapter.charts.findIndex((chart) => chapter.readings?.some((r) => r.chartId === chart.spec.chartId))
const main = mainIndex >= 0 ? chapter.charts[mainIndex] : chapter.charts[0]
const mainReading = main ? chapter.readings?.find((r) => r.chartId === main.spec.chartId) : undefined
const others = chapter.charts.filter((chart) => chart !== main)
const mainKeyFact = mainReading?.keyFigure ? facts[mainReading.keyFigure.factId] : undefined

const steps = [
  mainReading?.keyFigure && { kind: 'key' as const, state: 0 },
  mainReading?.conclusion && { kind: 'conclusion' as const, state: 1 },
  mainReading?.meaning && { kind: 'meaning' as const, state: 2 },
  mainReading?.nextStep && { kind: 'next' as const, state: 3 },
].filter(Boolean) as Array<{ kind: 'key' | 'conclusion' | 'meaning' | 'next'; state: number }>

const provenance = (factIds: string[]) => {
  const list = factIds.map((id) => facts[id]).filter(Boolean)
  return {
    sources: [...new Set(list.map((f) => f.source))].join(' y '),
    // 1.2 — el corte legible que manda Greenhouse («20 sept 2026»); el formato propio queda sólo para modelos previos.
    asOf: (() => {
      const latest = [...list].filter((f) => f.asOf).sort((a, b) => (a.asOf! < b.asOf! ? -1 : 1)).at(-1)
      return latest ? latest.asOfLabel ?? shortDate(latest.asOf) : null
    })(),
    estimated: list.some((f) => f.observation === 'estimated'),
  }
}

const shownFacts = new Set([...chapter.charts.flatMap((c) => chartFactIds(c.spec)), mainReading?.keyFigure?.factId])
// 1.2 — la cifra del período anterior acompaña a la actual; nunca va como tarjeta suelta con la misma etiqueta.
const comparisonIds = new Set(Object.values(facts).map((f) => f.comparisonFactId).filter((id): id is string => !!id))
// 1.2 — con roles, se DICEN los hallazgos; el respaldo queda sólo como cifra. Sin roles (modelos previos), como antes.
const hasRoles = chapter.claims.some((claim) => claim.role)
// Y no se repite en frase lo que una figura ya dibuja (clics e impresiones están en la figura y en su lectura).
const spokenClaims = hasRoles
  ? chapter.claims.filter((claim) => claim.role !== 'backing' && claim.factIds.some((id) => !shownFacts.has(id) && !comparisonIds.has(id)))
  : chapter.claims
const looseFacts = [...new Set(chapter.claims.flatMap((claim) => claim.factIds))].filter((id) => !shownFacts.has(id) && !comparisonIds.has(id)).map((id) => facts[id]).filter(Boolean)
const isEmpty = chapter.charts.length === 0 && chapter.claims.length === 0 && chapter.tables.length === 0
const mainProv = main ? provenance(chartFactIds(main.spec)) : null
---

<section class="ins-scene" id={`cap-${number}`} data-section data-module={chapter.module} data-capture={`chapter-${chapter.module}`} aria-labelledby={`cap-${number}-title`}>
  <header class="ins-scene__head" data-reveal>
    {chapter.productMark ? (
      /* La marca de producto reemplaza la etiqueta del capítulo, nunca se suma a ella (línea gráfica, submarcas). */
      <span class="ins-scene__mark">
        <span class="ins-chip ins-num">{number}</span>
        <img src={`/branding/products/${chapter.productMark.key.replace(/_/g, '-')}-lockup-positive.svg`} alt={chapter.productMark.label} height="26" />
      </span>
    ) : (
      <span class="ins-chip ins-num">{number} · {C.moduleLabel[chapter.module] ?? chapter.module}</span>
    )}
    <h2 class="ins-scene__title" id={`cap-${number}-title`} tabindex="-1">{chapter.title}</h2>
    {chapter.opening && <p class="ins-lead">{chapter.opening.text}</p>}
  </header>

  {isEmpty && <div class="ins-empty" data-reveal><p>{C.chapterEmpty}</p></div>}

  {main && (
    <div class:list={['ins-story', { 'ins-story--plain': steps.length === 0 }]} data-story>
      <div class="ins-story__stage" data-reveal>
        <ChartFigure spec={main.spec} table={main.table} derived={main.derived} copy={C} facts={facts} locale={locale} uid={`fig-${chapter.chapterId}`} />
        {mainProv && (
          <div class="ins-provrow" data-reveal>
            {(main.unitLabel ?? '') !== '' && <span><b>{C.provenanceUnit}</b>{main.unitLabel}</span>}
            <span><b>{C.provenanceSource}</b>{mainProv.sources}</span>
            {mainProv.asOf && <span class="ins-num"><b>{C.asOf}</b>{mainProv.asOf}</span>}
            <FactMark copy={C} observation={mainProv.estimated ? 'estimated' : 'observed'} />
          </div>
        )}
      </div>
      {steps.length > 0 && (
        <ol class="ins-story__steps">
          {steps.map((step) => (
            <li class="ins-step" data-step={step.state}>
              {step.kind === 'key' && mainReading?.keyFigure && (
                <div class="ins-step__key">
                  <span class="ins-figure-lg" data-countup={mainKeyFact?.value ?? undefined} data-display={mainReading.keyFigure.value}>{mainReading.keyFigure.value}</span>
                  <p>{mainReading.keyFigure.caption.text}</p>
                </div>
              )}
              {step.kind === 'conclusion' && <h3 class="ins-h3">{mainReading?.conclusion?.text}</h3>}
              {step.kind === 'meaning' && (
                <div class="ins-step__card"><span class="ins-label">{C.meaningTitle}</span><p>{mainReading?.meaning?.text}</p></div>
              )}
              {step.kind === 'next' && (
                <div class="ins-step__card ins-step__card--next"><span class="ins-label">{C.nextStepTitle}</span><p>{mainReading?.nextStep?.text}</p></div>
              )}
            </li>
          ))}
        </ol>
      )}
    </div>
  )}

  {others.length > 0 && (
    <div class="ins-chain">
      {others.map((chart, i) => {
        const reading = chapter.readings?.find((r) => r.chartId === chart.spec.chartId)
        const keyFact = reading?.keyFigure ? facts[reading.keyFigure.factId] : undefined
        return (
          <article class:list={['ins-beat', { 'ins-beat--flip': i % 2 === 1 }]} data-reveal>
            <div class="ins-beat__text">
              <span class="ins-beat__kind">{C.familyLabel[chart.spec.family] ?? chart.spec.family}</span>
              {reading?.keyFigure && (
                <span class="ins-figure-md" data-countup={keyFact?.value ?? undefined} data-display={reading.keyFigure.value}>{reading.keyFigure.value}</span>
              )}
              <h3 class="ins-h3">{reading?.conclusion?.text ?? chart.spec.title}</h3>
              {reading?.meaning && <p class="ins-beat__meaning">{reading.meaning.text}</p>}
              {reading?.nextStep && (
                <p class="ins-beat__next"><span class="ins-label">{C.nextStepTitle}</span>{reading.nextStep.text}</p>
              )}
            </div>
            <div class="ins-beat__figure">
              <ChartFigure spec={chart.spec} table={chart.table} derived={chart.derived} copy={C} facts={facts} locale={locale} uid={`fig-${chart.spec.chartId}`} compact />
            </div>
          </article>
        )
      })}
    </div>
  )}

  {(spokenClaims.length > 0 || looseFacts.length > 0) && (
    <div class="ins-more" data-reveal>
      {spokenClaims.length > 0 && <ul class="ins-claims" data-stagger>{spokenClaims.map((claim) => <li>{claim.text}</li>)}</ul>}
      {looseFacts.length > 0 && (
        <div class="ins-facts" data-stagger>
          {looseFacts.map((fact) => (
            <div class="ins-fact">
              <span class="ins-fact__head">
                {fact.channelId && fact.module === 'aeo'
                  ? <EngineMark provider={fact.channelId} label={fact.label} size={22} />
                  : insightIconFor(fact.metricId) && <img class="ins-fact__icon" src={insightIconFor(fact.metricId)!} alt="" width="22" height="22" />}
                <span class="ins-label">{fact.label}</span>
              </span>
              {fact.value === null ? (
                <>
                  <span class="ins-fact__absent" role="img" aria-label={C.absent} />
                  <span class="ins-prov"><span class="ins-mark">{C.absent}</span><span>{C.absentReason}</span></span>
                </>
              ) : (
                <>
                  <span class="ins-figure-md" data-countup={fact.value} data-display={fact.display}>{fact.display}</span>
                  {fact.comparisonFactId && facts[fact.comparisonFactId] && <span class="ins-fact__prior ins-num">{C.priorValue(facts[fact.comparisonFactId].display)}</span>}
                  <span class="ins-prov"><FactMark copy={C} observation={fact.observation} /><span>{fact.source}</span></span>
                </>
              )}
            </div>
          ))}
        </div>
      )}
    </div>
  )}

  {chapter.limits.length > 0 && (
    <div class="ins-limits" data-capture="limits" data-reveal>
      <span class="ins-label">{C.limitsTitle}</span>
      <ul>
        {chapter.limits.map((limit) => (
          <li><svg viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-dasharray="2.4 2" /></svg>{limit}</li>
        ))}
      </ul>
    </div>
  )}
</section>
