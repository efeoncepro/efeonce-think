---
/**
 * Informe de Efeonce Insights (TASK-1875, greenhouse-eo): el render de `InsightWebModelV1`, compartido por el enlace
 * con token (`/insights/r/<token>`) y por la muestra pública para clientes (`/insights/muestra`). Un solo render para
 * que la muestra nunca se desalinee del producto.
 *
 * `mode="shared"`: enlace de un cliente (estado del enlace, vencimiento, logo y descargas por la misma URL).
 * `mode="sample"`: datos de ejemplo; sin descargas ni logo (no hay archivo ni cliente) y con invitación a conversar.
 */
import '@fontsource-variable/bricolage-grotesque/opsz.css'
import '@fontsource/poppins/400.css'
import '@fontsource/poppins/500.css'
import '@fontsource/poppins/600.css'
import '@fontsource/poppins/800.css'
import '@fontsource/poppins/800-italic.css'
import '@fontsource/poppins/900-italic.css'
import '@styles/insights.css'

import ModuleScene from '@/components/insights/ModuleScene.astro'
import ChartFigure from '@/components/insights/ChartFigure.astro'
import FactMark from '@/components/insights/FactMark.astro'
import { buildFindings, buildModules, splitLead, splitSummary } from '@lib/insights-view'
import { getInsightsCopy } from '@lib/insights-copy'
import { insightsCssVars, orbitMeasure, motion } from '@lib/insights-tokens'
import type { InsightSharedEditionResponseV1 } from '@lib/insights'

interface Props {
  edition: InsightSharedEditionResponseV1
  mode?: 'shared' | 'sample'
}

const { edition, mode = 'shared' } = Astro.props
const sample = mode === 'sample'
const model = edition.model
const locale = model.locale ?? 'es-CL'
const C = getInsightsCopy(model.locale)
const header = edition.header

// ── Presentación: fechas del header y geometría; ningún dato nuevo ───────────
const civil = (iso: string) => iso.slice(0, 10)
const dayBefore = (iso: string) => new Date(Date.parse(`${civil(iso)}T00:00:00Z`) - 86_400_000).toISOString().slice(0, 10)
const toDate = (iso: string) => new Date(iso.length === 10 ? `${iso}T12:00:00Z` : iso)
const longDate = (iso: string, timeZone = 'UTC') => new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone }).format(toDate(iso))
const dayMonth = (iso: string, timeZone = 'UTC') => new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'long', timeZone }).format(toDate(iso))

const partial = !!header?.asOfMax && civil(header.asOfMax) < dayBefore(header.periodEndExclusive)
const asOfShort = header?.asOfMax ? dayMonth(header.asOfMax) : null
const expiresShort = edition ? dayMonth(edition.expiresAt, header?.timeZone) : null
const expiresLong = edition ? longDate(edition.expiresAt, header?.timeZone) : null

const findings = model ? buildFindings(model) : []
const modules = model ? buildModules(model) : []
const summary = splitSummary(model)
// Titular en dos pesos: la respuesta y su consecuencia. El texto queda íntegro (la puntuación de unión se conserva).
const answer = splitLead(summary.headline?.text ?? header.reportTitle)
const decision = model?.decision ? splitLead(model.decision.text) : null
const downloads = sample ? [] : edition.downloads.filter((d) => d.output !== 'web')
const primaryDownload = downloads.find((d) => d.status === 'available')

// Órbita de la portada: de acento (`trajectory.accent`), no una medida: el modelo no declara una cifra de portada y el
// arco nunca decora un número. Arco de 50°, esfera en la punta con su anillo «en vivo», halo detrás.
const R = 450
const size = R * 2
const w = (px: number) => (px * (1440 / orbitMeasure.base.widthPx)).toFixed(2)
const polar = (deg: number) => {
  const a = ((deg - 90) * Math.PI) / 180
  return { x: R + R * Math.cos(a), y: R + R * Math.sin(a) }
}
const ARC_START = 250
const ARC_SWEEP = orbitMeasure.trailDeg
const arcFrom = polar(ARC_START)
const arcTo = polar(ARC_START + ARC_SWEEP)
const arcPath = `M ${arcFrom.x.toFixed(2)} ${arcFrom.y.toFixed(2)} A ${R} ${R} 0 0 1 ${arcTo.x.toFixed(2)} ${arcTo.y.toFixed(2)}`
const haloR = (R * orbitMeasure.haloRadiusRatio).toFixed(1)

const moduleOf = (factIds: string[]) => (model ? factIds.map((id) => model.facts[id]?.module).find(Boolean) : undefined)
const short = (iso: string | null) => (iso ? iso.slice(0, 10).split('-').reverse().join('-') : null)
const cssVars = Object.entries(insightsCssVars).map(([name, value]) => `--${name}:${value}`).join(';')

const downloadIcon = '<svg viewBox="0 0 18 18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3v9M5 8l4 4 4-4M3 15h12"/></svg>'
const linkIcon = '<svg viewBox="0 0 18 18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7.5 10.5l3-3M6 8L4.6 9.4a2.8 2.8 0 004 4L10 12M12 10l1.4-1.4a2.8 2.8 0 00-4-4L8 6"/></svg>'
const plusIcon = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M8 3v10M3 8h10"/></svg>'
---

<div class="ins-page" style={cssVars} data-filter="all">
  {/* Antes del primer paint: marca que hay JS y prepara el motion sólo si el usuario lo acepta. Si el módulo no
      monta en 3 s, se retira todo y la página queda completa: el motion nunca condiciona el contenido. */}
  <script is:inline>
    document.documentElement.classList.add('ins-js')
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('ins-motion')
    setTimeout(function () { if (!window.__insMounted) document.documentElement.classList.remove('ins-motion', 'ins-js') }, 3000)
  </script>
  <a class="ins-skip" href="#hallazgos">{C.skipLink}</a>

  <header class="ins-hero ins-dark" data-capture="masthead" data-hero>
    <div class="ins-orbit" aria-hidden="true" data-orbit data-r={R} data-start={ARC_START} data-sweep={ARC_SWEEP} data-ms={motion.orbitMs.travel} data-delay={motion.orbitMs.travelDelay}>
      <svg viewBox={`0 0 ${size} ${size}`}>
        <defs>
          <radialGradient id="ins-halo" cx={R} cy={R} r={haloR} gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="var(--ins-halo)" stop-opacity="0.14" />
            <stop offset="0.54" stop-color="var(--ins-halo)" stop-opacity="0.05" />
            <stop offset="1" stop-color="var(--ins-halo)" stop-opacity="0" />
          </radialGradient>
        </defs>
        <circle class="ins-orbit__halo" cx={R} cy={R} r={haloR} fill="url(#ins-halo)" />
        <circle class="ins-orbit__ring" cx={R} cy={R} r={R} fill="none" stroke="var(--ins-halo)" stroke-opacity={orbitMeasure.ringOpacity} stroke-width={w(orbitMeasure.base.ringStrokePx)} />
        <path class="ins-orbit__arc" d={arcPath} fill="none" stroke="var(--ins-accent-dark)" stroke-width={w(orbitMeasure.base.trailStrokePx)} stroke-linecap="round" />
        <circle class="ins-orbit__live" cx={arcTo.x.toFixed(2)} cy={arcTo.y.toFixed(2)} r={w(orbitMeasure.base.sphereRadiusPx)} fill="none" stroke="var(--ins-accent-dark)" stroke-width="1.5" />
        <circle class="ins-orbit__sphere" cx={arcTo.x.toFixed(2)} cy={arcTo.y.toFixed(2)} r={w(orbitMeasure.base.sphereRadiusPx)} fill="var(--ins-accent-dark)" />
      </svg>
    </div>

    <div class="ins-hero__bar">
      <img class="ins-lockup ins-screen-only" src="/branding/insights/insights-lockup-negative.svg" alt="Efeonce Insights" width="277" height="32" />
      <img class="ins-lockup ins-print-only" src="/branding/insights/insights-lockup-positive.svg" alt="" width="277" height="32" />
      <ul class="ins-status" aria-label={C.statusLabel}>
        {sample ? (
          <li><span class="ins-status__dot" aria-hidden="true" />{C.sampleChip}</li>
        ) : (
          <>
            <li><span class="ins-status__dot" aria-hidden="true" />{C.linkActive}</li>
            {expiresShort && <li class="ins-num">{C.expiresShort(expiresShort)}</li>}
          </>
        )}
      </ul>
    </div>

    <div class="ins-hero__body">
      <p class="ins-hero__kicker"><span>{header.reportTitle}</span><span class="ins-num">{header.periodLabel}</span></p>
      <h1 class="ins-hero__answer"><span class="ins-answer__lead">{answer.lead}{answer.joiner.trim()}</span>{answer.rest && <> <span class="ins-answer__rest">{answer.rest}</span></>}</h1>
      {summary.rest.map((claim) => <p class="ins-hero__lead">{claim.text}</p>)}
      {header.clientLogo && !sample && (
        <p class="ins-hero__client">
          <span>{C.preparedFor}</span>
          <span class:list={['ins-hero__logo', { 'ins-hero__logo--plate': header.clientLogo.variant === 'default' }]}>
            <img src="?logo=1" alt={C.clientLogoAlt(header.organizationName)} height="32" />
          </span>
        </p>
      )}
      <p class="ins-hero__meta ins-num">
        <span>{header.clientLogo && !sample ? <b>{header.organizationName}</b> : <>{C.preparedFor} <b>{header.organizationName}</b></>}</span>
        <span>{C.editionValue(header.reportCode, header.editionVersion)}</span>
        {asOfShort && <span>{C.dataAsOf(asOfShort)}</span>}
      </p>
    </div>

    <a class="ins-hero__cue" href="#hallazgos" aria-label={C.findingsTitle}>
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
    </a>
  </header>

  {partial && (
    <div class="ins-partial" role="note">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><circle cx="9" cy="9" r="7" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="3 3" /></svg>
      <strong>{C.periodPartial}</strong>
      <span>{C.periodPartialDetail}</span>
    </div>
  )}

  <nav class="ins-topbar" data-bar aria-label={C.filtersLabel}>
    <div class="ins-topbar__inner">
      <span class="ins-topbar__orbit" aria-hidden="true" data-progress>
        <svg viewBox="0 0 32 32">
          <circle cx="16" cy="16" r="12" fill="none" stroke="var(--ins-halo)" stroke-opacity="0.28" stroke-width="1.5" />
          <circle class="ins-topbar__arc" cx="16" cy="16" r="12" fill="none" stroke="var(--ins-accent-dark)" stroke-width="2.2" stroke-linecap="round" pathLength="100" stroke-dasharray="100" stroke-dashoffset="96" transform="rotate(-90 16 16)" />
          <g class="ins-topbar__sphere"><circle cx="16" cy="4" r="3" fill="var(--ins-accent-dark)" /></g>
        </svg>
      </span>
      <div class="ins-filters" role="group" aria-label={C.filtersLabel}>
        <button type="button" data-filter-btn="all" aria-pressed="true">{C.filterAll}</button>
        {modules.map((m) => <button type="button" data-filter-btn={m.module} aria-pressed="false">{C.moduleLabel[m.module] ?? m.title}</button>)}
      </div>
      <div class="ins-topbar__actions">
        {model.actions.length > 0 && <a class="ins-topbar__link" href="#plan">{C.filterPlan}</a>}
        <button type="button" class="ins-topbar__link ins-present-open" data-present-open aria-haspopup="dialog">
          <svg viewBox="0 0 18 18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 3.5h13v9h-13zM9 12.5v3M6 15.5h6M7.5 6.3l3.5 1.7-3.5 1.7z" /></svg>{C.present}
        </button>
        <button type="button" class="ins-iconbtn" data-copy-link aria-label={C.copyLink} set:html={linkIcon} />
        {primaryDownload && (
          <a class="ins-btn ins-btn--small" href={`?descargar=${primaryDownload.output}`} download><Fragment set:html={downloadIcon} /><span>{C.downloadShort}</span></a>
        )}
      </div>
    </div>
  </nav>

  <section class="ins-findings ins-dark" id="hallazgos" data-section data-capture="summary" aria-labelledby="hallazgos-title">
    <div class="ins-findings__head" data-reveal>
      <h2 class="ins-findings__title" id="hallazgos-title" tabindex="-1">{C.findingsTitle}</h2>
      <p class="ins-findings__lead">{C.findingsLead}</p>
    </div>
    <div class="ins-tiles" data-stagger>
      {findings.map((finding, i) => (
        <article class:list={['ins-tile', { 'ins-tile--lead': i === 0 }]} id={finding.id} data-module={finding.module ?? 'all'} data-finding>
          <button type="button" class="ins-tile__hit" aria-expanded="false" aria-controls={`${finding.id}-ev`}>
            <span class="ins-tile__top">
              <span class="ins-chip ins-chip--dark">{finding.module ? C.moduleLabel[finding.module] : C.filterAll}</span>
              <span class="ins-tile__plus" aria-hidden="true" set:html={plusIcon} />
            </span>
            {finding.fact && (
              <span class="ins-tile__figure" data-countup={finding.fact.value ?? undefined} data-display={finding.fact.display}>
                {finding.fact.value === null ? C.absent : finding.fact.display}
              </span>
            )}
            <span class="ins-tile__claim">{finding.claim.text}</span>
            {finding.fact && (
              <span class="ins-tile__prov">
                {finding.fact.value === null ? <span class="ins-mark">{C.absent}</span> : <FactMark copy={C} observation={finding.fact.observation} />}
                <span>{finding.fact.source}</span>
              </span>
            )}
            <span class="ins-visually-hidden">{C.findingOpen}</span>
          </button>

          <div class="ins-tile__evidence" id={`${finding.id}-ev`} role="region" aria-label={`${C.findingOpen}: ${finding.fact?.label ?? finding.claim.text}`}>
            {finding.evidence ? (
              <>
                {finding.evidence.reading?.conclusion && <p class="ins-tile__conclusion">{finding.evidence.reading.conclusion.text}</p>}
                <ChartFigure copy={C} derived={finding.evidence.chart.derived} spec={finding.evidence.chart.spec} table={finding.evidence.chart.table} facts={model.facts} locale={locale} theme="dark" uid={`ev-${finding.id}`} compact />
                {(finding.evidence.reading?.meaning || finding.evidence.reading?.nextStep) && (
                  <div class="ins-tile__reading">
                    {finding.evidence.reading?.meaning && <div><span class="ins-label">{C.meaningTitle}</span><p>{finding.evidence.reading.meaning.text}</p></div>}
                    {finding.evidence.reading?.nextStep && <div><span class="ins-label">{C.nextStepTitle}</span><p>{finding.evidence.reading.nextStep.text}</p></div>}
                  </div>
                )}
              </>
            ) : (
              <p class="ins-tile__conclusion ins-tile__conclusion--muted">{C.noEvidenceChart}</p>
            )}
            {finding.fact && (
              <dl class="ins-tile__facts">
                <div><dt>{finding.fact.label}</dt><dd class="ins-num">{finding.fact.value === null ? C.absent : finding.fact.display}</dd></div>
                <div><dt>{C.provenanceSource}</dt><dd>{finding.fact.source}</dd></div>
                {finding.fact.asOf && <div><dt>{C.asOf}</dt><dd class="ins-num">{short(finding.fact.asOf)}</dd></div>}
              </dl>
            )}
            <div class="ins-tile__actions">
              <button type="button" class="ins-textbtn" data-copy-link={finding.id}><Fragment set:html={linkIcon} />{C.copyFindingLink}</button>
              <button type="button" class="ins-textbtn" data-close>{C.findingClose}</button>
            </div>
          </div>
        </article>
      ))}
    </div>

    {model.decision && (
      <div class="ins-decision" data-reveal>
        <span class="ins-label">{C.decisionTitle}</span>
        <p class="ins-decision__lead">{decision!.lead}</p>
        {decision!.rest && <p class="ins-decision__rest">{decision!.rest}</p>}
        {model.actions.length > 0 && <a class="ins-decision__link" href="#plan">{C.planTitle} <span aria-hidden="true">→</span></a>}
      </div>
    )}
  </section>

  <main class="ins-main" id="contenido">
    {model.chapters.map((chapter, i) => <ModuleScene chapter={chapter} index={i + 1} facts={model.facts} locale={locale} copy={C} />)}

    {model.actions.length > 0 && (
      <section class="ins-plan" id="plan" data-section aria-labelledby="plan-title">
        <div class="ins-plan__head" data-reveal>
          <span class="ins-plan__count" data-countup={model.actions.length} data-display={String(model.actions.length)}>{model.actions.length}</span>
          <div>
            <span class="ins-label">{C.planTitle}</span>
            <h2 class="ins-plan__title" id="plan-title" tabindex="-1">{C.planLead}</h2>
          </div>
        </div>
        {(model.measurement || model.ask) && (
          <div class="ins-plan__terms" data-reveal>
            {model.measurement && <div><span class="ins-label">{C.measurementTitle}</span><p>{model.measurement.text}</p></div>}
            {model.ask && <div><span class="ins-label">{C.askTitle}</span><p>{model.ask.text}</p></div>}
          </div>
        )}
        <ol class="ins-actions" data-stagger>
          {model.actions.map((action) => {
            const module = moduleOf(action.factIds)
            return (
              <li>
                <span class="ins-actions__text">{action.text}</span>
                {module && <span class="ins-chip">{C.moduleLabel[module]}</span>}
              </li>
            )
          })}
        </ol>
      </section>
    )}

    <section class="ins-how" id="metodologia" data-reveal data-section data-capture="methodology" aria-labelledby="metodologia-title">
      <details class="ins-how__details">
        <summary>
          <span>
            <span class="ins-how__title" id="metodologia-title">{C.howMeasured}</span>
            <span class="ins-how__lead">{C.howMeasuredLead}</span>
          </span>
          <span class="ins-tile__plus" aria-hidden="true" set:html={plusIcon} />
        </summary>
        <div class="ins-how__body">
          {model.methodology.length > 0 && <ul class="ins-method">{model.methodology.map((line) => <li>{line}</li>)}</ul>}
          <div class="ins-twocol">
            {model.limits.length > 0 && <div><span class="ins-label">{C.editionLimits}</span>{model.limits.map((limit) => <p>{limit}</p>)}</div>}
            {model.references.length > 0 && <div><span class="ins-label">{C.references}</span><ol>{model.references.map((ref) => <li>{ref.label}</li>)}</ol></div>}
          </div>
        </div>
      </details>
    </section>

    {sample ? (
    <section class="ins-sample-cta ins-dark" id="conversemos" data-capture="sample-cta" aria-labelledby="conversemos-title" data-reveal>
      <h2 class="ins-sample-cta__title" id="conversemos-title">{C.sampleCtaTitle}</h2>
      <p class="ins-sample-cta__body">{C.sampleCtaBody}</p>
      <a class="ins-decision__link" href="mailto:sales@efeoncepro.com?subject=Efeonce%20Insights">{C.sampleCtaButton} <span aria-hidden="true">→</span></a>
    </section>
    ) : (
    <section class="ins-downloads" id="descargas" data-reveal data-capture="downloads" aria-labelledby="descargas-title">
      <h2 class="ins-label" id="descargas-title">{C.downloadsTitle}</h2>
      <div class="ins-downloads__row">
        {downloads.map((download) => (
          <div class="ins-download">
            <div class="ins-download__name"><b>{C.downloadLabel[download.output]}</b><span>{C.downloadFormat[download.output]}</span></div>
            {download.status === 'available' ? (
              <a class="ins-btn" href={`?descargar=${download.output}`} download><Fragment set:html={downloadIcon} />{C.downloadCta}</a>
            ) : (
              <span class="ins-download__na">{C.downloadUnavailable}</span>
            )}
          </div>
        ))}
      </div>
    </section>
    )}
  </main>

  <footer class="ins-footer ins-dark" data-capture="footer">
    <div class="ins-footer__inner" data-reveal>
      <div class="ins-signature">
        <img class="ins-screen-only" src="/branding/efeonce-logo-negative.svg" alt="Efeonce" width="200" height="47" />
        <img class="ins-print-only" src="/branding/efeonce-logo.svg" alt="" width="200" height="47" />
        <p class="ins-slogan"><span class="e">Empower</span> <span class="y">your</span> <span class="g">Growth</span></p>
      </div>
      <ul class="ins-contact">
        <li><a href="mailto:sales@efeoncepro.com">sales@efeoncepro.com</a></li>
        <li>Chile +56 9 3732 3064</li>
        <li>Estados Unidos +1 (239) 235-2073</li>
        <li>Providencia, Chile</li>
      </ul>
      <div class="ins-footer__base">
        <p class="ins-footer__notice"><span class="ins-status__dot" aria-hidden="true" /><span>{sample ? C.sampleNotice : <>{C.linkNotice} {expiresLong && C.linkExpires(expiresLong)}</>}</span></p>
        <p class="ins-legal">{C.confidential(header.organizationName, header.reportCode, header.editionVersion)}</p>
      </div>
    </div>
  </footer>

  <div class="ins-dock" aria-label={C.dockLabel}>
    <button type="button" class="ins-dock__btn" data-copy-link><Fragment set:html={linkIcon} />{C.copyLink}</button>
    {primaryDownload && <a class="ins-dock__btn ins-dock__btn--primary" href={`?descargar=${primaryDownload.output}`} download><Fragment set:html={downloadIcon} />{C.downloadShort}</a>}
  </div>

  {/* Modo presentación: el informe como diapositivas para mostrarlo en la reunión (flechas, Esc). */}
  <div class="ins-present ins-dark" data-present hidden role="dialog" aria-modal="true" aria-label={C.presentLabel} tabindex="-1">
    <div class="ins-present__stage">
      <section class="ins-slide ins-slide--cover" data-slide>
        <img class="ins-slide__lockup" src="/branding/insights/insights-lockup-negative.svg" alt="Efeonce Insights" width="277" height="32" />
        <p class="ins-slide__kicker">{header.reportTitle} · {header.periodLabel}</p>
        <h2 class="ins-slide__headline"><span class="ins-answer__lead">{answer.lead}{answer.joiner.trim()}</span>{answer.rest && <> <span class="ins-answer__rest">{answer.rest}</span></>}</h2>
        <p class="ins-slide__meta">{C.preparedFor} {header.organizationName}</p>
      </section>
      {findings.map((finding, i) => (
        <section class:list={['ins-slide', 'ins-slide--finding', { 'is-lead': i === 0 }]} data-slide>
          <span class="ins-chip ins-chip--dark">{finding.module ? C.moduleLabel[finding.module] : C.filterAll}</span>
          {finding.fact && <span class="ins-slide__figure ins-num">{finding.fact.value === null ? C.absent : finding.fact.display}</span>}
          <p class="ins-slide__claim">{finding.claim.text}</p>
          {finding.evidence?.reading?.nextStep && <p class="ins-slide__next"><span class="ins-label">{C.nextStepTitle}</span>{finding.evidence.reading.nextStep.text}</p>}
          {finding.fact && <p class="ins-slide__source">{finding.fact.source}</p>}
        </section>
      ))}
      {model.decision && (
        <section class="ins-slide ins-slide--decision" data-slide>
          <span class="ins-label">{C.decisionTitle}</span>
          <p class="ins-slide__decision">{decision!.lead}</p>
          {decision!.rest && <p class="ins-slide__claim">{decision!.rest}</p>}
        </section>
      )}
      {model.actions.length > 0 && (
        <section class="ins-slide ins-slide--plan" data-slide>
          <span class="ins-label">{C.planTitle}</span>
          <ol class="ins-slide__actions">{model.actions.slice(0, 5).map((action) => <li>{action.text}</li>)}</ol>
        </section>
      )}
      <section class="ins-slide ins-slide--close" data-slide>
        <img src="/branding/efeonce-logo-negative.svg" alt="Efeonce" width="320" height="75" />
