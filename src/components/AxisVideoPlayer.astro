---
import {videoPlayerHtml,type VideoPlayerModel} from '@efeoncepro/axis-ui-primitives/video-player'
import '@efeoncepro/axis-ui-primitives/video-player.css'
import {serializeAxisVideoOptions,type AxisVideoSerializableOptions} from '@/lib/axis-video-client'
interface Props {model:VideoPlayerModel; options?:AxisVideoSerializableOptions}
const {model,options={}}=Astro.props
const safeOptions=serializeAxisVideoOptions(options)
const config=JSON.stringify({model,options:safeOptions}).replace(/</g,'\\u003c')
---
<div data-axis-player data-axis-loading={safeOptions.loading ?? 'visible'}>
  <Fragment set:html={videoPlayerHtml(model)} />
  <script is:inline type="application/json" data-axis-config set:html={config} />
</div>
<script>
import {installAxisVideoPlayers} from '@/lib/axis-video-client'
installAxisVideoPlayers()
</script>
