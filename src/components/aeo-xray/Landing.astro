---
import LandingModules from './LandingModules.astro'
import SpecimenHeader from './SpecimenHeader.astro'
import Image from './SampleImage.astro'
import type {RenderSample} from '@/lib/aeo-xray/render-model'
import type {AxisAeoXrayArtifact,AxisAeoXrayManifest} from '@/lib/axis/aeo-xray/aeo-xray.js'
import {experienceHref} from '@/lib/aeo-xray/experience-adapter'
interface Props {d:RenderSample;landing?:unknown;coupled?:boolean;produces?:Map<string,number>;hero?:string}
const {d,coupled=false,produces=new Map(),hero}=Astro.props
const context=Astro.props.landing as {artifact:AxisAeoXrayArtifact;model:AxisAeoXrayManifest}|undefined
const headline=d.article.blocks.find(b=>b.type==='h1')
const photo=d.article.blocks.find(b=>b.type==='hero-image')
const marketing=context?.artifact.blocks.find(b=>b.kind==='hero')
const sections=d.article.blocks.filter(b=>b.type==='h2'||b.type==='faq')
const body={...d,article:{...d.article,blocks:d.article.blocks.filter(b=>b!==headline&&b!==photo&&!(b.type==='paragraph'&&marketing?.kind==='hero'&&b.text===marketing.text))}}
const id=headline?.coupleId??''
const count=produces.get(id)??0
const attrs=(id:string)=>coupled?{id:`block-${id}`,'data-couple':id,'data-n':`${produces.get(id)??0} ${d.ui.producesLabel}`,'data-on':id===hero?true:undefined}:{}
const action=marketing?.kind==='hero'?marketing.cta:undefined
const href=action?.artifactId?experienceHref(action.artifactId,'articulo',action.blockId):action?.href
---
<div class:list={['landing',{'landing-split':coupled}]} style={`--landing-action:${context?.model.brand?.action??context?.model.tokens.shell.accent??d.client.accent};--landing-action-ink:${context?.model.brand?.actionText??context?.model.tokens.shell.ink??'white'}`}>
  <SpecimenHeader name={d.client.name} model={context?.model} links={[...sections.slice(0,2),...sections.filter(b=>b.type==='faq')].map(b=>({text:b.short,href:`#${'anchor'in b?b.anchor:''}`}))} action={action&&href?{text:action.label,href}:undefined}/>
  <section id="specimen-top" class="landing-hero sp" aria-label="Propuesta de landing">
    <div class="landing-copy blk" {...attrs(id)}>

      {marketing?.kind==='hero'&&marketing.eyebrow&&marketing.eyebrow!==marketing.title&&<p class="landing-eyebrow">{marketing.eyebrow}</p>}
      <h1>{headline&&'text'in headline?headline.text:d.meta.sampleTitle}</h1>
      {marketing?.kind==='hero'&&<p class="landing-lead">{marketing.text}</p>}
      {action&&<a class="landing-action" href={href}>{action.label}<span aria-hidden="true"> →</span></a>}

      {coupled&&count>0&&<button class="probe" type="button" data-probe aria-controls="in-body" aria-expanded="false">{d.ui.srProduces.replace('{n}',String(count))}</button>}
    </div>
    {photo&&'src'in photo&&<figure class="landing-photo blk" {...attrs(photo.coupleId??'')}>
      <Image class="xr-hero-img" src={photo.src} alt={photo.alt} loading="eager" fetchpriority="high" widths={[640,960]} sizes="(min-width:1080px) 40vw,100vw" format="avif"/>
      {coupled&&(produces.get(photo.coupleId??'')??0)>0&&<button class="probe" type="button" data-probe aria-controls="in-body" aria-expanded="false">{d.ui.srProduces.replace('{n}',String(produces.get(photo.coupleId??'')))}</button>}
      <figcaption>{photo.credit.author}</figcaption>
    </figure>}
  </section>
  <LandingModules d={body} coupled={coupled} produces={produces} hero={hero} context={context}/>
</div>
<style>
.landing .blk{position:relative}

.landing{view-transition-name:xr-article;min-width:0;background:white;color:var(--ink)}
.landing-hero{position:relative;display:block;min-height:536px;overflow:hidden;border-radius:var(--r);background:white}
.landing-copy{position:relative;z-index:1;max-width:58%;padding:3rem 1.5rem 3rem max(1.5rem,calc((100vw - 1160px)/2));align-self:center}
.landing-brand{font-weight:700;color:var(--client);margin-bottom:3rem;font-size:1.1rem}
.landing-eyebrow{font-size:.8rem;letter-spacing:.12em;text-transform:uppercase;margin-bottom:1rem}
.landing h1,.landing h2{font-family:var(--client-font);font-size:clamp(2.4rem,3.8vw,3.5rem);line-height:1.06;letter-spacing:-.04em;color:var(--client);text-wrap:balance;margin:0 0 1.5rem}
.landing-copy h1{max-width:600px;text-wrap:initial}.landing-lead{font-size:1.15rem;line-height:1.6;max-width:42ch}.landing-action{display:inline-flex;align-items:center;justify-content:space-between;gap:2rem;padding:1rem 1.4rem;background:var(--landing-action);color:var(--landing-action-ink);border-radius:.4rem;font-weight:700;margin-top:1.8rem;text-decoration:none;min-height:48px}
.landing-disclosure{font-size:.75rem;line-height:1.5;margin-top:1.25rem;color:var(--muted)}
.landing .landing-photo{margin:0;position:absolute;inset:0;z-index:0;overflow:hidden}.landing-photo :global(img){width:100%;height:100%;object-fit:cover;display:block}.landing-photo figcaption{z-index:2;position:absolute;bottom:0;right:0;font-size:.75rem;padding:.4rem .6rem;line-height:1.5;background:white}
.landing :global(.sp){view-transition-name:none}
.landing :global(.sp-head){display:none}.landing :global(.post){font-family:var(--font-sans)}
.landing-split .landing-hero{min-height:400px}.landing-split .landing-copy{padding:1.5rem}.landing-split h1{font-size:clamp(1.8rem,2.7vw,3rem)}.landing-split .landing-brand{margin-bottom:1.5rem}
.landing :global(.blk[data-on]){outline:2px solid var(--client);outline-offset:-2px}.landing .probe{width:44px;height:44px;background:transparent;border:0;padding:0}.landing-photo .probe{right:0;left:auto}
@media(max-width:900px){.landing-hero,.landing-split .landing-hero{display:flex;flex-direction:column;min-height:0}.landing-copy{max-width:100%}.landing .landing-photo{position:relative;inset:auto;order:2}.landing-photo :global(img){height:auto;width:100%}.landing-copy,.landing-split .landing-copy{padding:2rem 1.5rem}.landing-photo{max-width:100%;width:100%}.landing-photo :global(img){max-height:none}.landing h1,.landing h2{font-size:2.5rem}.landing .landing-rates h2{font-size:1.9rem}}
</style>
