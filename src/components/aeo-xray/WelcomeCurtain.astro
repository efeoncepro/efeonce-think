---
import {ArrowUp} from '@lucide/astro'
import type {AxisAeoXrayManifest} from '@/lib/axis/aeo-xray/aeo-xray.js'
import {assetHref} from '@/lib/aeo-xray/view'
import {xrayCopy as C} from '@/lib/aeo-xray/copy'
interface Props {model:AxisAeoXrayManifest;enabled:boolean}
const {model,enabled}=Astro.props
const logo=model.assets.find(asset=>asset.id===model.brand?.logoAssetId)
---
{enabled&&<dialog open class="xr-curtain" data-xray-curtain aria-labelledby="xr-welcome-title">
  <div class="curtain-layout">
    <div class="curtain-invitation">
      <div class="curtain-client">{logo?<img src={assetHref(logo)} alt={model.preparedFor} width={logo.width} height={logo.height} loading="eager" decoding="sync"/>:<p>{model.preparedFor}</p>}</div>
      <h2 id="xr-welcome-title">{C.welcome.title}</h2>
      <form method="dialog"><button type="submit" class="curtain-enter" autofocus><span>{C.welcome.enter}</span><ArrowUp size={21} stroke-width={1.6} aria-hidden="true" focusable="false"/></button></form>
    </div>
    <footer class="curtain-signature">
      <img class="curtain-logo" src="/branding/aeo-lockup-negative.svg" alt="Efeonce AEO" width="228" height="30"/>
      <a class="curtain-url" href="https://efeoncepro.com/" target="_blank" rel="noopener noreferrer" aria-label="efeoncepro.com"><img src="/branding/url-bubble-baked-dark.svg" alt="efeoncepro.com" width="163" height="32"/></a>
    </footer>
  </div>
</dialog>}
<script is:inline>
  // Apply remembered entry before the first paint; no-JS keeps the native form.
  try {
    if (sessionStorage.getItem(`xray-welcome:${location.pathname}`) === 'opened') {
      document.querySelector('[data-xray-curtain]')?.removeAttribute('open')
    }
  } catch {}
</script>
<script>
  const seenKey=()=>`xray-welcome:${location.pathname}`
  const seen=()=>{try{return sessionStorage.getItem(seenKey())==='opened'}catch{return false}}
  const remember=()=>{try{sessionStorage.setItem(seenKey(),'opened')}catch{/* Storage may be unavailable; internal navigation still skips the curtain. */}}

  function initializeCurtain(){
    const candidate=document.querySelector<HTMLDialogElement>('[data-xray-curtain]')
    if(!candidate||candidate.dataset.ready)return
    const dialog=candidate
    dialog.dataset.ready='true'
    // Internal navigation is prepared before the view-transition snapshot.
    if(!dialog.open||seen()){dialog.close();return}
    const root=dialog.closest<HTMLElement>('.xr')!
    const button=dialog.querySelector<HTMLButtonElement>('button')!
    const controller=new AbortController(),{signal}=controller
    const reduced=matchMedia('(prefers-reduced-motion: reduce)')
    let animations:Animation[]=[]
    let opening=false,finished=false
    dialog.removeAttribute('open')
    dialog.showModal()

    function finish(notify=true){
      if(finished)return
      finished=true
      remember()
      dialog.close()
      animations.forEach(animation=>animation.cancel())
      animations=[]
      controller.abort()
      if(notify){
        const title=root.querySelector<HTMLElement>('[data-opportunity] h1')
        title?.setAttribute('tabindex','-1')
        title?.focus({preventScroll:true})
        document.dispatchEvent(new CustomEvent('xray:curtain-opened'))
      }
    }
    function open(){
      if(opening||finished)return
      opening=true;button.disabled=true;remember()
      dialog.dataset.state='opening'
      if(reduced.matches){finish();return}
      document.dispatchEvent(new CustomEvent('xray:curtain-opening'))
      const style=getComputedStyle(root)
      const duration=parseFloat(style.getPropertyValue('--xr-motion-open'))
      const easing=style.getPropertyValue('--xr-motion-ease').trim()
      const timing={duration,easing,fill:'both' as FillMode}
      const lift=dialog.animate([{transform:'translateY(0)'},{transform:'translateY(-100%)'}],timing)
      animations.push(lift)
      const content=root.querySelector('main')
      if(content)animations.push(content.animate([{transform:'translateY(56px)'},{transform:'translateY(0)'}],timing))
      lift.finished.then(()=>finish()).catch(()=>finish())
    }
    dialog.querySelector('form')!.addEventListener('submit',event=>{event.preventDefault();open()},{signal})
    dialog.addEventListener('cancel',event=>{event.preventDefault();open()},{signal})
    reduced.addEventListener('change',()=>{if(opening&&reduced.matches)finish()},{signal})
    document.addEventListener('visibilitychange',()=>{if(opening&&document.hidden)finish()},{signal})
    document.addEventListener('astro:before-preparation',()=>finish(false),{signal})
  }
  // A welcome belongs to entry, never to Back, an artifact switch or a deep link.
  document.addEventListener('astro:before-swap',event=>{
    const next=(event as import('astro:transitions/client').TransitionBeforeSwapEvent).newDocument
    next.querySelector('[data-xray-curtain]')?.removeAttribute('open')
  })
  initializeCurtain()
  document.addEventListener('astro:page-load',initializeCurtain)
</script>
<style>
  .xr-curtain{--curtain-display:Poppins,system-ui,sans-serif;--curtain-body:'Geist Variable',system-ui,sans-serif;position:fixed;inset:0;width:100%;height:100dvh;max-width:none;max-height:none;margin:0;padding:0;border:0;background:var(--navy-sunk);color:var(--ink-d);overflow:auto;overscroll-behavior:contain;z-index:1000;font-family:var(--curtain-body)}
  .xr-curtain:not([open]){display:none}.xr-curtain::backdrop{background:transparent}
  .curtain-layout{min-height:100%;display:flex;flex-direction:column;align-items:center;padding:clamp(2rem,6vh,5rem) 1.5rem max(2rem,env(safe-area-inset-bottom));box-sizing:border-box;text-align:center}
  .curtain-invitation{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:2rem 0 5rem;min-height:360px}
  .curtain-client{display:grid;place-items:center;background:var(--surf);padding:1.1rem 1.5rem;border-radius:6px;max-width:100%;color:var(--ink);margin-bottom:clamp(2.5rem,6vh,4.5rem)}
  .curtain-client img{width:clamp(190px,22vw,270px);height:auto;max-height:85px;object-fit:contain;display:block}.curtain-client p{margin:0;font:500 1.5rem/1.4 var(--curtain-display)}
  .curtain-invitation h2{font:500 clamp(1.9rem,4vw,3.2rem)/1.23 var(--curtain-display);letter-spacing:-.025em;text-wrap:balance;max-width:16ch;margin:0 0 2rem;color:var(--ink-d)}
  .curtain-enter{display:inline-flex;align-items:center;justify-content:center;gap:1.6rem;min-height:56px;padding:1rem 1.5rem;border-radius:999px;border:1px solid var(--line-d);background:var(--ink-d);color:var(--navy);font:600 .95rem/1 var(--curtain-body);cursor:pointer;transition:background-color var(--xr-motion-morph) var(--xr-motion-ease)}
  .curtain-enter:hover{background:var(--blue-up)}.curtain-enter:disabled{cursor:default}.curtain-enter:focus-visible,.curtain-url:focus-visible{outline:2px solid var(--blue-up);outline-offset:7px}
  .curtain-signature{display:flex;flex-direction:column;align-items:center;gap:1.4rem;flex-shrink:0;padding-top:2rem}.curtain-logo{width:228px;height:30px;object-fit:contain}.curtain-url{display:flex;align-items:center;min-height:44px}.curtain-url img{width:163px;height:32px;display:block}
  @media(max-width:620px){.curtain-layout{padding-top:1.5rem;padding-bottom:max(1.5rem,env(safe-area-inset-bottom))}.curtain-invitation{padding:2rem 0 3.5rem;min-height:340px}.curtain-client{padding:1rem 1.25rem}.curtain-signature{gap:1rem}.curtain-logo{width:205px;height:auto}}
  @media(max-height:580px){.curtain-invitation{min-height:0;padding:1rem 0 2rem}.curtain-client{margin-bottom:1.5rem}.curtain-invitation h2{font-size:1.85rem;margin-bottom:1.2rem}.curtain-signature{padding-top:1rem;gap:.75rem}}
  @media(prefers-reduced-motion:reduce){.curtain-enter{transition:none}}
  @media print{.xr-curtain{display:none!important}}
  :global(html:has(.xr-curtain[open])){overflow:hidden}
</style>
