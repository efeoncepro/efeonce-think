---
/** 0.2.0 · Cómo llegaría la pieza a revisión (`experience.review`): cada dato con su documento, responsable y estado. */
import {ArrowRight, CircleCheck, CircleDot, MessageSquare, PencilLine} from '@lucide/astro'
import type {AxisAeoXrayArtifact} from '@/lib/axis/aeo-xray/aeo-xray.js'
import {xrayCopy as C} from '@/lib/aeo-xray/copy'
interface Props{artifact:AxisAeoXrayArtifact;hrefBlock:(id:string)=>string}
const {artifact,hrefBlock}=Astro.props
const review=artifact.experience?.review
const E=C.early
// «Sobre:» nombra la sección de la pieza donde vive el bloque, no su texto.
const sectionOf=new Map<string,string>()
let current=artifact.title
for(const b of artifact.blocks){
  if(b.kind==='heading')current=b.text
  else if(b.kind==='hero')current=b.title
  sectionOf.set(b.id,b.kind==='faq'?(b.title??current):current)
}
const blockName=(id?:string)=>id?(sectionOf.get(id)??'').replace(/\.$/,''):''
const initials=(role:string)=>role.split(/\s+/).filter(Boolean).slice(0,2).map(w=>w[0]).join('').toUpperCase()
---
{review&&<section class="review" aria-labelledby={`review-${artifact.id}`} data-review>
  <header>
    <p class="early-eyebrow">{E.reviewEyebrow}</p>
    <h2 id={`review-${artifact.id}`}>{review.title}</h2>
    <p>{review.intro}</p>
    <span class="review-version">{review.version}</span>
  </header>
  <div class="review-body">
    <div>
      <h3>{E.reviewClaims}</h3>
      <ul class="review-items">{review.items.map(it=><li data-status={it.status}>
        <span class="review-icon" aria-hidden="true">{it.status==='approved'?<CircleCheck size={20}/>:it.status==='changes'?<PencilLine size={20}/>:<CircleDot size={20}/>}</span>
        <div><strong>{it.claim}</strong>
          <p><span>{E.reviewDocument}:</span> {it.document}</p>
          <p><span>{E.reviewOwner}:</span> {it.owner}</p>
          <a href={hrefBlock(it.coupleId)} data-astro-prefetch="false">{E.reviewSee}<ArrowRight size={14} aria-hidden="true"/></a>
        </div>
        <span class:list={['chip',`status-${it.status}`]}>{E.status[it.status]}</span>
      </li>)}</ul>
    </div>
    {review.comments.length>0&&<aside>
      <h3><MessageSquare size={17} aria-hidden="true"/>{E.reviewComments}</h3>
      <ol class="review-thread">{review.comments.map(c=><li>
        <span class="review-avatar" aria-hidden="true">{initials(c.role)}</span>
        <div><strong>{c.role}</strong>{c.coupleId&&<span class="review-on">{E.reviewOn}: {blockName(c.coupleId)}</span>}<p>{c.text}</p></div>
      </li>)}</ol>
    </aside>}
  </div>
  <p class="early-note">{review.note}</p>
</section>}
<style>
.review{max-width:1160px;margin:0 auto;padding:3.5rem 1.5rem 1rem;color:var(--ink);font-family:'Geist Variable',system-ui,sans-serif}
.review>header{position:relative;max-width:760px;margin-bottom:1.75rem}
.review h2{font:500 clamp(1.5rem,2.3vw,2rem)/1.3 Poppins,system-ui,sans-serif;margin:0 0 .6rem;text-wrap:balance}
.review>header>p{font-size:.95rem;line-height:1.75;color:var(--ink-3);margin:0}
.review-version{display:inline-block;margin-top:.9rem;padding:.25rem .65rem;border-radius:999px;background:var(--surf-2);border:1px solid var(--line-2);font-size:.75rem;font-weight:600;color:var(--ink-2)}
.review-body{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:2rem;align-items:start}
.review h3{display:flex;align-items:center;gap:.45rem;font-size:var(--t-over);text-transform:uppercase;letter-spacing:.07em;color:var(--ink-3);font-weight:600;margin:0 0 .75rem}
.review-items{list-style:none;margin:0;padding:0;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:white}
.review-items li{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:.9rem;padding:1rem 1.1rem;border-top:1px solid var(--line);align-items:start}
.review-items li:first-child{border-top:0}
.review-icon{color:var(--muted);padding-top:.1rem}
.review-items li[data-status=approved] .review-icon{color:#1f8a4c}
.review-items li[data-status=changes] .review-icon{color:#c2410c}
.review-items strong{display:block;font-size:.95rem;font-weight:600;margin-bottom:.3rem}
.review-items p{margin:.1rem 0;font-size:.82rem;line-height:1.55;color:var(--ink-2)}
.review-items p span{color:var(--muted)}
.review-items a{display:inline-flex;align-items:center;gap:.25rem;margin-top:.45rem;font-size:.8rem;font-weight:600;color:var(--ax-primary-700);text-decoration:none}
.review-items a:hover{text-decoration:underline}
:global(.status-pending){background:color-mix(in srgb,#f5b301 16%,white);color:#7a5200;border-color:color-mix(in srgb,#f5b301 40%,white)}
:global(.status-approved){background:color-mix(in srgb,#1f8a4c 12%,white);color:#14612f;border-color:color-mix(in srgb,#1f8a4c 30%,white)}
:global(.status-changes){background:color-mix(in srgb,#c2410c 12%,white);color:#9a3412;border-color:color-mix(in srgb,#c2410c 30%,white)}
.review aside{border:1px solid var(--line);border-radius:12px;padding:1.1rem;background:var(--surf)}
.review-thread{list-style:none;margin:0;padding:0;display:grid;gap:1rem}
.review-thread li{display:grid;grid-template-columns:36px minmax(0,1fr);gap:.75rem}
.review-avatar{width:36px;height:36px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;background:var(--navy);color:white;font-size:.75rem;font-weight:600}
.review-thread strong{font-size:.85rem;font-weight:600;margin-right:.5rem}
.review-on{font-size:.72rem;color:var(--muted)}
.review-thread p{margin:.3rem 0 0;font-size:.85rem;line-height:1.6;color:var(--ink-2);background:white;border:1px solid var(--line);border-radius:4px 12px 12px 12px;padding:.6rem .8rem}
.review .early-note{margin-top:1rem}
@media(max-width:860px){.review{padding:2.5rem 1rem .5rem}.review-body{grid-template-columns:1fr}.review-items li{grid-template-columns:auto minmax(0,1fr)}.review-items .chip{grid-column:2;justify-self:start}}
</style>
