---
import {ArrowUpRight, ChevronDown, ScanLine, ArrowRight} from '@lucide/astro'
import type {AxisAeoXrayArtifact,AxisAeoXrayManifest} from '@/lib/axis/aeo-xray/aeo-xray.js'
import {experienceHref} from '@/lib/aeo-xray/experience-adapter'
import {xrayCopy as C} from '@/lib/aeo-xray/copy'
interface Props{artifact:AxisAeoXrayArtifact;model:AxisAeoXrayManifest}
const {artifact,model}=Astro.props
const questions=artifact.experience?.evidence.fanOut.items??[]
const cases=questions.map(q=>{
 const block=artifact.blocks.find(b=>b.id===q.coveredBy)
 const decisions=artifact.annotations.filter(a=>a.blockId===q.coveredBy)
 const ids=new Set([...(block?.sourceIds??[]),...decisions.flatMap(a=>a.sourceIds)])
 return {q,block,decisions,sources:model.sources.filter(s=>ids.has(s.id))}
}).filter(c=>c.block)
const V=C.value
---
{cases.length>0&&<details class="value-explorer" data-value-explorer>
 <summary><span class="value-label"><ScanLine size={19}/><strong>{V.summary}</strong><span class="value-count">{cases.length} {V.questions}</span></span><span class="value-open">{V.open}<ChevronDown size={17}/></span></summary>
 <div class="value-surface">
  <header><p class="value-kicker">{V.eyebrow}</p><h2>{V.title}</h2><p>{V.intro}</p></header>
  <div class="value-workbench">
   <nav class="value-questions" aria-label={V.choose} hidden>{cases.map((c,i)=><button type="button" data-value-select={i} aria-pressed={i===0} aria-controls={`value-${artifact.id}-${i}`}><span aria-hidden="true">0{i+1}</span>{c.q.q}<ArrowRight size={17}/></button>)}</nav>
   <div class="value-panels">{cases.map((c,i)=><section class="value-case" data-value-panel={i} id={`value-${artifact.id}-${i}`}>
    <h3>{c.q.q}</h3>
    <div class="value-answer"><p class="value-label-small">{V.answer}</p>
     {c.block?.kind==='table'?<div class="value-table"><table><thead><tr>{c.block.columns.map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{c.block.rows.map(row=><tr>{row.map(t=><td>{t}</td>)}</tr>)}</tbody></table><p class="value-caption">{c.block.caption}</p></div>:c.block?.kind==='faq'?<div class="value-faq">{c.block.items.map(item=><details><summary>{item.question}<ChevronDown size={16}/></summary><p>{item.answer}</p></details>)}</div>:c.block?.kind==='list'?<ul>{c.block.items.map(t=><li>{t}</li>)}</ul>:c.block&&'text'in c.block?<p class="value-excerpt">{c.block.text}</p>:c.block&&'title'in c.block?<p class="value-excerpt">{c.block.title}</p>:null}
    </div>
    <div class="value-decisions"><p class="value-label-small">{V.why}</p>{c.decisions.map(a=><div class="value-decision"><div><span>{C.categories[a.category]}</span><span>{C.statuses[a.status]}</span></div><h4>{a.title}</h4><p>{a.explanation}</p></div>)}</div>
    {c.sources.length>0&&<div class="value-sources"><p class="value-label-small">{V.sources}</p>{c.sources.map(s=><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}<span>{s.accessedAt}</span><ArrowUpRight size={15}/></a>)}</div>}
    <div class="value-actions"><a class="value-primary" href={experienceHref(artifact.id,'radiografia',`block-${c.q.coveredBy}`)}>{V.inspect}<ArrowRight size={18}/></a><a href={experienceHref(artifact.id,'articulo',`block-${c.q.coveredBy}`)}>{V.read}</a></div>
   </section>)}</div>
  </div>
  <details class="value-measure"><summary>{V.measureTitle}<ChevronDown size={19}/></summary><p>{V.measureIntro}</p><dl>{V.measure.map(m=><div><dt>{m.label}</dt><dd><strong>{m.question}</strong><p>{m.method}</p></dd></div>)}</dl></details>
 </div>
</details>}
<script>
 function initValueExplorer(){document.querySelectorAll<HTMLElement>('[data-value-explorer]:not([data-value-ready])').forEach(root=>{
  root.dataset.valueReady='true'
  const buttons=root.querySelectorAll<HTMLButtonElement>('[data-value-select]'),panels=root.querySelectorAll<HTMLElement>('[data-value-panel]')
  root.querySelector<HTMLElement>('.value-questions')!.hidden=false
  const select=(id:string)=>{buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.valueSelect===id)));panels.forEach(p=>p.hidden=p.dataset.valuePanel!==id)}
  buttons.forEach(b=>b.addEventListener('click',()=>{select(b.dataset.valueSelect!);if(!matchMedia('(prefers-reduced-motion: reduce)').matches)root.querySelector('[data-value-panel]:not([hidden])')?.animate([{opacity:.35,transform:'translateY(8px)'},{opacity:1,transform:'none'}],{duration:240,easing:'ease-out'})}))
  // Collapse before the piece becomes the specimen, keeping its transformation in view.
  root.querySelectorAll<HTMLAnchorElement>('.value-actions a').forEach(a=>a.addEventListener('click',()=>{(root as HTMLDetailsElement).open=false}))
  select('0')
 })}
 initValueExplorer();document.addEventListener('astro:page-load',initValueExplorer)
</script>
<style>
.value-explorer{background:var(--navy);color:var(--ink-d);font-family:var(--font-sans);border-top:1px solid var(--line-d);border-bottom:1px solid var(--line-d)}.value-explorer>summary{max-width:1440px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:54px;cursor:pointer;padding:.8rem 1.5rem;font-size:.85rem;list-style:none}.value-explorer>summary::-webkit-details-marker{display:none}.value-label{display:flex;align-items:center;gap:.75rem}.value-label svg{color:var(--blue-up)}.value-count{color:var(--dim-d);font-size:.75rem;border-left:1px solid var(--line-d);padding-left:.75rem}.value-open{display:flex;align-items:center;gap:.65rem;color:var(--ink-d)}.value-explorer[open] .value-open>svg{transform:rotate(180deg)}.value-surface{max-width:1160px;margin:auto;padding:2.5rem 1.5rem 3rem}.value-surface>header{max-width:750px;margin-bottom:2rem}.value-kicker,.value-label-small{text-transform:uppercase;letter-spacing:.08em;font-size:.7rem;color:var(--blue-up);font-weight:600;margin:0 0 .75rem}.value-surface h2{font-family:var(--font-display);font-size:clamp(1.6rem,2.5vw,2.15rem);font-weight:500;line-height:1.25;margin:0 0 .75rem}.value-surface>header>p:last-child{font-size:.95rem;color:var(--dim-d);line-height:1.7;margin:0}.value-workbench{display:grid;grid-template-columns:290px minmax(0,1fr);gap:2.5rem}.value-workbench:not(:has(.value-questions:not([hidden]))){grid-template-columns:1fr}.value-case+.value-case:not([hidden]){margin-top:2rem}.value-questions{display:flex;flex-direction:column;gap:.5rem}.value-questions[hidden]{display:none}.value-questions button{display:flex;align-items:flex-start;gap:.65rem;width:100%;border:1px solid transparent;border-radius:var(--r);background:transparent;color:var(--dim-d);text-align:left;padding:1rem;font:inherit;font-size:.88rem;line-height:1.6;cursor:pointer}.value-questions button span{font-size:.7rem;color:var(--blue-up);padding-top:.2rem}.value-questions button svg{flex-shrink:0;margin-left:auto;margin-top:.3rem}.value-questions button[aria-pressed=true]{color:var(--ink-d);border-color:var(--line-d);background:var(--navy-2)}.value-case{min-width:0;padding-left:2.5rem;border-left:1px solid var(--line-d)}.value-case[hidden]{display:none}.value-case h3{font-family:var(--font-display);font-weight:500;font-size:1.3rem;line-height:1.5;margin:0 0 1.5rem}.value-answer{background:var(--ink-d);color:var(--ink);padding:1.5rem;border-radius:var(--r);margin-bottom:1.5rem}.value-answer .value-label-small{color:var(--ink-3)}.value-excerpt{font-size:1rem;line-height:1.7;margin:0}.value-table{overflow:auto}.value-table table{width:100%;border-collapse:collapse;font-size:.8rem}.value-table th,.value-table td{padding:.65rem .6rem;text-align:left;border-bottom:1px solid var(--line-2)}.value-table th{font-weight:600}.value-caption{font-size:.7rem;line-height:1.6;color:var(--ink-3);margin:1rem 0 0}.value-decision{padding:0 0 1.25rem}.value-decision>div{display:flex;flex-wrap:wrap;gap:.75rem;font-size:.68rem;color:var(--dim-d)}.value-decision h4{font-size:1rem;font-weight:600;margin:.45rem 0}.value-decision p{font-size:.88rem;line-height:1.7;color:var(--dim-d);margin:0}.value-sources{padding-top:1.2rem;border-top:1px solid var(--line-d)}.value-sources a{display:flex;align-items:center;flex-wrap:wrap;gap:.6rem;text-decoration:none;color:var(--ink-d);font-size:.8rem;margin:.75rem 0}.value-sources a span{color:var(--dim-d);font-size:.7rem}.value-sources a svg{flex-shrink:0}.value-actions{display:flex;align-items:center;gap:1.2rem;flex-wrap:wrap;margin-top:1.5rem;font-size:.8rem}.value-actions a{color:var(--ink-d)}.value-primary{display:inline-flex;align-items:center;gap:1rem;background:var(--ax-primary-700);border:1px solid var(--blue-up);padding:.8rem 1rem;border-radius:var(--r);text-decoration:none}.value-measure{margin-top:2rem;border-top:1px solid var(--line-d)}.value-measure>summary{display:flex;justify-content:space-between;align-items:center;gap:1rem;list-style:none;cursor:pointer;padding:1.5rem 0;font-size:1rem;font-weight:600}.value-measure>p{font-size:.9rem;line-height:1.7;color:var(--dim-d);max-width:85ch;margin:0 0 1rem}.value-measure dl{margin:0}.value-measure dl>div{display:grid;grid-template-columns:180px 1fr;border-top:1px solid var(--line-d);padding:1rem 0;gap:1.5rem}.value-measure dt{color:var(--blue-up);font-size:.9rem}.value-measure dd{margin:0;font-size:.85rem;line-height:1.7}.value-measure dd p{margin:.25rem 0 0;color:var(--dim-d)}.value-faq details{border-top:1px solid var(--line)}.value-faq summary{display:flex;align-items:center;justify-content:space-between;gap:1rem;cursor:pointer;padding:.75rem 0;font-size:.85rem;font-weight:600}.value-faq p{font-size:.85rem;line-height:1.7;margin:0 0 1rem}.value-faq svg{flex-shrink:0}.value-explorer :is(button,a,summary):focus-visible{outline:2px solid var(--blue-up);outline-offset:4px}
@media(max-width:800px){.value-workbench{grid-template-columns:1fr;gap:1.5rem}.value-case{padding:0;border:0}.value-questions{display:grid;grid-template-columns:1fr}.value-questions button{padding:.65rem 1rem}.value-measure dl>div{grid-template-columns:1fr;gap:.5rem}.value-count{display:none}.value-open{font-size:.75rem}.value-label{gap:.5rem}.value-label strong{font-size:.78rem}.value-surface{padding-top:1.5rem}.value-answer{padding:1rem}.value-surface h2{font-size:1.6rem}}
@media(max-width:380px){.value-explorer>summary{padding-inline:1rem}.value-open{max-width:85px;line-height:1.3}.value-label svg{display:none}}
</style>
