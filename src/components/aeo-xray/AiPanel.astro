---
/** 0.2.0 · Muestra real del panel de respuestas de IA (efeonce.aeo-xray `experience.aiPanel`). Sólo existe si el modelo lo trae. */
import {Check, ChevronDown, Minus, X} from '@lucide/astro'
import type {AxisAeoXrayArtifact,AxisAeoXrayManifest} from '@/lib/axis/aeo-xray/aeo-xray.js'
import {xrayCopy as C} from '@/lib/aeo-xray/copy'
interface Props{artifact:AxisAeoXrayArtifact;model:AxisAeoXrayManifest}
const {artifact,model}=Astro.props
const panel=artifact.experience?.aiPanel
const E=C.early
const brand=model.brand?.name??model.preparedFor
const site=new URL(artifact.seo.canonical).hostname.replace(/^www\./,'')
const fill=(t:string,v:Record<string,string|number>={})=>Object.entries({brand,site,...v}).reduce((s,[k,x])=>s.replaceAll(`{${k}}`,String(x)),t)
const generic=panel?.rows.filter(r=>r.kind==='generic'&&!r.surface)??[]
const appears=generic.filter(r=>r.appears).length
const own=generic.filter(r=>r.citesOwnSite).length
const date=(d:string)=>d.split('-').reverse().join('/')
---
{panel&&<section class="ai-panel" aria-labelledby={`ai-panel-${artifact.id}`} data-ai-panel>
  <header>
    <p class="early-eyebrow">{E.aiEyebrow}</p>
    <h2 id={`ai-panel-${artifact.id}`}>{panel.title}</h2>
    <p>{panel.intro}</p>
  </header>
  {generic.length>0&&<p class="ai-summary"><strong>{fill(E.aiSummaryGeneric,{appears,total:generic.length,surface:panel.surface})}</strong> {fill(E.aiSummaryOwnSite,{own,total:generic.length})}</p>}
  <div class="ai-table" role="region" aria-labelledby={`ai-panel-${artifact.id}`} tabindex="0">
    <table>
      <thead><tr><th scope="col">{E.aiQuestion}</th><th scope="col">{fill(E.aiAppears)}</th><th scope="col">{E.aiAccuracy}</th><th scope="col">{fill(E.aiOwnSite)}</th><th scope="col">{E.aiCited}</th></tr></thead>
      <tbody>{panel.rows.map(r=><tr data-appears={String(r.appears)} data-accuracy={r.accuracy}>
        <th scope="row"><span class="ai-q">«{r.question}»</span><span class="ai-meta">{E.aiKind[r.kind]} · {r.surface??panel.surface} · {date(r.asOf??panel.asOf)}</span><span class="ai-detail">{r.detail}</span></th>
        <td><span class="m-label">{fill(E.aiAppears)}</span><span class:list={['chip',r.appears?'chip-yes':'chip-no']}>{r.appears?<Check size={14} aria-hidden="true"/>:<X size={14} aria-hidden="true"/>}{r.appears?E.yes:E.no}</span></td>
        <td><span class="m-label">{E.aiAccuracy}</span><span class:list={['chip',`chip-${r.accuracy}`]}>{r.accuracy==='correct'?<Check size={14} aria-hidden="true"/>:r.accuracy==='incorrect'?<X size={14} aria-hidden="true"/>:<Minus size={14} aria-hidden="true"/>}{E.accuracy[r.accuracy]}</span></td>
        <td><span class="m-label">{fill(E.aiOwnSite)}</span><span class:list={['chip',r.citesOwnSite?'chip-yes':'chip-no']}>{r.citesOwnSite?E.yes:E.no}</span></td>
        <td><span class="m-label">{E.aiCited}</span><ul class="ai-cited">{r.cited.map(c=><li>{c}</li>)}</ul></td>
      </tr>)}</tbody>
    </table>
  </div>
  <details class="early-method"><summary>{E.aiMethod}<ChevronDown size={16} aria-hidden="true"/></summary><p>{panel.method}</p><p>{panel.market} · {panel.surface} · {date(panel.asOf)}</p></details>
  <p class="early-note">{panel.note}</p>
</section>}
<style>
.ai-panel{padding:3rem 1rem 0;color:var(--ink);font-family:'Geist Variable',system-ui,sans-serif}
.ai-panel>header{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);column-gap:3rem;align-items:start;margin-bottom:1.25rem}
.ai-panel>header .early-eyebrow{grid-column:1/-1}
.ai-panel h2{font:500 clamp(1.4rem,2vw,1.85rem)/1.4 Poppins,system-ui,sans-serif;margin:0;max-width:24ch;text-wrap:balance}
.ai-panel>header>p:last-child{font-size:.9rem;line-height:1.8;color:var(--ink-3);margin:0}
:global(.early-eyebrow){text-transform:uppercase;letter-spacing:.08em;font-size:var(--t-over);font-weight:600;color:var(--blue);margin:0 0 .8rem}
.ai-summary{border-top:1px solid var(--line-2);padding-top:1.25rem;margin:0 0 1rem;font-size:1.05rem;line-height:1.6}
.ai-summary strong{font-weight:600}
.ai-table{overflow-x:auto;border:1px solid var(--line);border-radius:12px}
.ai-table:focus-visible{outline:2px solid var(--blue);outline-offset:3px}
.ai-table table{width:100%;border-collapse:collapse;font-size:.85rem;min-width:760px}
.ai-table th,.ai-table td{padding:.9rem 1rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--line)}
.ai-table thead th{font-size:var(--t-over);text-transform:uppercase;letter-spacing:.06em;color:var(--ink-3);font-weight:600;background:var(--surf);white-space:nowrap}
.ai-table tbody tr:last-child>*{border-bottom:0}
.ai-table tbody th{font-weight:400;width:38%}
.ai-q{display:block;font-weight:600;color:var(--ink)}
.ai-meta{display:block;font-size:var(--t-over);color:var(--muted);margin-top:.2rem}
.ai-detail{display:block;font-size:.8rem;line-height:1.55;color:var(--ink-2);margin-top:.45rem}
:global(.chip){display:inline-flex;align-items:center;gap:.3rem;padding:.2rem .55rem;border-radius:999px;font-size:.75rem;font-weight:600;white-space:nowrap;border:1px solid transparent}
:global(.chip-yes),:global(.chip-correct){background:color-mix(in srgb,#1f8a4c 12%,white);color:#14612f;border-color:color-mix(in srgb,#1f8a4c 30%,white)}
:global(.chip-no){background:var(--surf-2);color:var(--ink-2);border-color:var(--line-2)}
:global(.chip-incorrect){background:color-mix(in srgb,#c2410c 12%,white);color:#9a3412;border-color:color-mix(in srgb,#c2410c 30%,white)}
:global(.chip-not-mentioned){background:var(--surf);color:var(--muted);border-color:var(--line)}
.m-label{display:none}
.ai-cited{list-style:none;margin:0;padding:0;font-size:.8rem;line-height:1.6;color:var(--ink-2)}
:global(.early-method){margin-top:1rem;border-top:1px solid var(--line)}
:global(.early-method>summary){display:flex;align-items:center;gap:.4rem;cursor:pointer;list-style:none;padding:.8rem 0;font-size:.85rem;font-weight:600;color:var(--ink-2)}
:global(.early-method>summary::-webkit-details-marker){display:none}
:global(.early-method p){font-size:.8rem;line-height:1.7;color:var(--ink-3);margin:0 0 .6rem;max-width:90ch}
:global(.early-note){font-size:.8rem;line-height:1.6;color:var(--muted);margin:.25rem 0 0;max-width:90ch}
@media(max-width:800px){
 .ai-panel{padding:2rem 0 0}
 .ai-panel>header{grid-template-columns:1fr;row-gap:.5rem}
 .ai-panel h2{max-width:none}
 .ai-table{border:0;overflow:visible}
 .ai-table table{min-width:0}
 .ai-table thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
 .ai-table tr{display:grid;grid-template-columns:1fr 1fr 1fr;gap:.75rem .6rem;padding:1rem;border:1px solid var(--line);border-radius:12px;margin-bottom:.75rem;align-items:start}
 .ai-table tbody th{grid-column:1/-1;width:auto;padding:0;border:0}
 .ai-table td{padding:0;border:0}
 .m-label{display:block;font-size:.65rem;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:.3rem;line-height:1.3}
 .ai-table td:last-child{grid-column:1/-1}
}
</style>
