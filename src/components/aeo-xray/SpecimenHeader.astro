---
import type {AxisAeoXrayManifest} from '@/lib/axis/aeo-xray/aeo-xray.js'
import {assetHref} from '@/lib/aeo-xray/view'
interface Props {name:string;model?:AxisAeoXrayManifest;links:Array<{text:string;href:string}>;action?:{text:string;href:string}}
const {name,model,links,action}=Astro.props
const logo=model?.assets.find(a=>a.id===model.brand?.logoAssetId)
---
<header class="specimen-nav">
 <a class="specimen-brand" href="#specimen-top">{logo?<img src={assetHref(logo)} width={logo.width} height={logo.height} alt={name}/>:name}</a>
 <nav aria-label="Secciones de la pieza">{links.map(l=><a href={l.href}>{l.text}</a>)}</nav>
 {action&&<a class="specimen-nav-action" href={action.href}>{action.text}</a>}
</header>
<style>
.specimen-nav{display:flex;align-items:center;gap:2rem;padding:1.1rem max(1.25rem,calc((100vw - 1160px)/2));background:white;border-bottom:1px solid var(--line);min-height:86px;color:var(--client)}.specimen-brand{font-size:1.2rem;font-weight:750;text-decoration:none;white-space:nowrap}.specimen-brand img{display:block;width:160px;max-height:48px;object-fit:contain}.specimen-nav nav{display:flex;gap:1.5rem;margin-left:auto;font-size:.85rem}.specimen-nav nav a{text-decoration:none}.specimen-nav-action{background:var(--landing-action);color:var(--landing-action-ink);padding:.85rem 1.2rem;border-radius:.35rem;font-weight:700;text-decoration:none;font-size:.85rem}
@media(max-width:680px){.specimen-nav{min-height:72px;gap:1rem;flex-wrap:wrap}.specimen-nav nav{order:3;margin-left:0;width:100%;gap:1rem;overflow:auto;white-space:nowrap}.specimen-nav-action{margin-left:auto;font-size:.72rem;padding:.7rem}.specimen-brand{font-size:1rem}.specimen-brand img{width:130px}}
</style>
