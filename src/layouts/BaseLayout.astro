---
import '@fontsource-variable/geist'
import '@styles/global.css'
import consentUiManifest from '../../public/measurement/consent-ui/manifest.json'

interface Props {
  title: string
  description?: string
  /** El informe per-lead es noindex (ADR §SEO); las landings de herramientas SÍ se indexan. */
  noindex?: boolean
  canonical?: string
  ogImage?: string
  ogTitle?: string
  ogDescription?: string
  ogImageAlt?: string
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  /**
   * `false` en páginas cuyo URL lleva una credencial (p. ej. el informe compartido de Insights,
   * `/insights/r/<token>`): sin GTM, el token nunca llega a `dataLayer` ni a GA4 como `page_location`, y
   * `no-referrer` evita que viaje en el Referer de un enlace saliente.
   */
  analytics?: boolean
  /** Idioma del documento (por defecto es-CL); el informe de Insights usa el de su edición. */
  lang?: string
}

const {
  title,
  description,
  noindex = false,
  canonical,
  ogImage,
  ogTitle = title,
  ogDescription = description,
  ogImageAlt = ogTitle,
  jsonLd,
  analytics = true,
  lang = 'es-CL',
} = Astro.props
const site = Astro.site ?? new URL('https://think.efeoncepro.com')
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, site).toString()
const absoluteOgImage = ogImage ? new URL(ogImage, site).toString() : undefined
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []
const safeJsonLd = (value: Record<string, unknown>) => JSON.stringify(value).replace(/</g, '\\u003c')
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Default first: cookie choices cannot arrive before an explicit denied state.
        analytics=false keeps credential-bearing reports free of all tracking/banner code. */}
    {analytics && <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };
      gtag('consent', 'default', { ad_storage:'denied', ad_user_data:'denied', ad_personalization:'denied', analytics_storage:'denied', functionality_storage:'denied', personalization_storage:'denied', security_storage:'granted' });
      window.efeonceConsentDefaultSet = true;
      window.efeonceConsentMeasurementEnabled = true;
      window.dataLayer.push({ meta_ads_consent:'denied', analytics_consent:'denied' });
    </script>}
    {analytics && <script is:inline src="/measurement/consent-bridge.v1.js?v=4250795666af" />}
    {analytics && <link rel="stylesheet" href={`/measurement/consent-ui/consent-ui.v1.css?v=${consentUiManifest.files['consent-ui.v1.css'].slice(0,12)}`} />}
    {analytics && <script is:inline defer src={`/measurement/consent-ui/consent-ui.v1.js?v=${consentUiManifest.files['consent-ui.v1.js'].slice(0,12)}`} />}
    {analytics && <script is:inline id="hs-script-loader" async defer src="https://js.hs-scripts.com/48713323.js" />}

    {/* Google Tag Manager — medición unificada con efeoncepro.com (misma propiedad GA4, container GTM-NGHPGRLZ).
        El page_view lo dispara un GA4 Config gateado por hostname dentro del container; los forms `<greenhouse-form>`
        emiten `gh_form_submission_accepted` → el tag genérico `generate_lead`. Doc: greenhouse-eo docs/reference/measurement-gtm-ga4. */}
    {analytics && <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-NGHPGRLZ');
    </script>}
    {!analytics && <meta name="referrer" content="no-referrer" />}

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#138760" />

    {/* Open Graph / Twitter — para unfurl bonito al compartir el link (NO afecta noindex) */}
    <meta property="og:title" content={ogTitle} />
    {ogDescription && <meta property="og:description" content={ogDescription} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Efeonce Think" />
    <meta property="og:locale" content="es_CL" />
    {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
    {absoluteOgImage && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content={absoluteOgImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={ogTitle} />
    {ogDescription && <meta name="twitter:description" content={ogDescription} />}
    {absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}
    {absoluteOgImage && <meta name="twitter:image:alt" content={ogImageAlt} />}
    {jsonLdItems.map((item) => <script type="application/ld+json" set:html={safeJsonLd(item)} is:inline />)}
    <slot name="head" />
  </head>
  <body class="min-h-dvh bg-white text-slate-900 antialiased" style="font-family:'Geist Variable',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif">
    {/* Google Tag Manager (noscript) */}
    {analytics && <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NGHPGRLZ" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>}
    <slot />
    {analytics && <script is:inline>
      (function () {
        // Solo se monta en un lugar declarado por el footer (o junto a su enlace de privacidad).
        // Nunca como hijo suelto del <footer>: queda fuera de la grilla y se ve huérfano.
        var privacy = Array.from(document.querySelectorAll('footer a[href*="/politica-de-privacidad"]')).pop();
        var host = document.querySelector('[data-efeonce-legal-links]') || (privacy && privacy.parentElement);
        if (!host || document.querySelector('[data-efeonce-cookie-settings]')) return;
        // Si el contenedor ya separa sus enlaces con aire (gap >= 16px), el «·» sobra.
        var hostStyle = getComputedStyle(host);
        var spaced = /flex|grid/.test(hostStyle.display) && parseFloat(hostStyle.columnGap) >= 16;
        var separator = document.createElement('span');
        separator.textContent = ' · ';
        separator.setAttribute('aria-hidden', 'true');
        var button = document.createElement('button');
        button.type = 'button';
        button.className = 'efeonce-cookie-preferences';
        button.setAttribute('data-efeonce-cookie-settings', '');
        button.textContent = 'Preferencias de cookies';
        if (spaced) host.append(button); else host.append(separator, button);
      })();
    </script>}
  </body>
</html>

<style is:global>
  .efeonce-cookie-preferences {
    appearance: none;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    line-height: inherit;
    padding: 0;
    min-height: 1.5em;
    cursor: pointer;
    text-align: inherit;
  }
  .efeonce-cookie-preferences:hover { text-decoration: underline; }
  .efeonce-cookie-preferences:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
</style>
